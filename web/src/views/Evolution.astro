---
/**
 * Evolution composition — "Itinerary on a slip" (Task 6 redesign).
 *
 * The evolution page is a paper-colored slip with a zigzag bottom edge,
 * showing three phases: Foundation (2017-2021), Transition (2021-2026), and
 * Frontier (recorded, no delivery dates). Each row has the milestone on the
 * left, the date on the right, with dot leaders between.
 *
 * The heading is large (clamp(40px, 4.4vw, 68px)), columns 1-5. The paragraph
 * is beside it, 30ch. The slip is columns 7-11.
 *
 * The final inverted row has paper text on an ink bar, 44px tall.
 *
 * Heading order: h1 (page) → h2 (phases).
 */
import type { Copy, Locale } from '../i18n/copy';
import Comments from '../components/Comments.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

/**
 * Evolution phases from the copy-deck. These are hardcoded editorial content,
 * not data. The timeline component still renders from data/milestones.json.
 */
const phases = [
  {
    name: 'Foundation',
    range: '2017 to 2021',
    items: [
      { label: 'Full-stack shipping at SINCOSOFT, ITEHL, BITS Americas', date: '2017' },
      { label: 'Azure, .NET, Java, Angular, SQL in production', date: '2021' },
    ],
  },
  {
    name: 'Transition',
    range: '2021 to 2026',
    items: [
      { label: 'Siigo: .NET, Angular, Azure, SQL', date: '2021' },
      { label: 'Talan: Azure, Java, React, Terraform, Node, Azure AI', date: '2023' },
      { label: 'Evidence-first portfolio published', date: '2026-10-03' },
      { label: 'Bilingual EN/ES release, accessibility parity', date: '2026-10-08' },
      { label: 'Astro rebuild merged, dual-host release', date: '2026-10-09' },
    ],
  },
  {
    name: 'Frontier',
    range: 'recorded, no delivery dates',
    items: [
      { label: 'AI engineering evidence build-out', date: 'planned' },
      { label: 'Agentic workflow lab, replay and adversarial iterations', date: 'planned' },
    ],
  },
];
---

<section class="evolution-page" id="evolution" aria-labelledby="evolution-heading">
  <div class="shell">
    <header class="evolution-page__header reveal">
      <h1 id="evolution-heading" class="evolution-page__heading">The evolution</h1>
      <p class="evolution-page__intro">
        Each milestone below is dated and linked to its evidence: a commit, a repository, a public record. Nothing is dated that did not happen.
      </p>
    </header>

    <div class="evolution-page__slip reveal">
      {phases.map((phase) => (
        <div class="evolution-slip__phase">
          <h2 class="evolution-slip__phase-name">
            {phase.name} — <span class="evolution-slip__phase-range">{phase.range}</span>
          </h2>
          <ul class="evolution-slip__list">
            {phase.items.map((item) => (
              <li class="evolution-slip__row">
                <span class="evolution-slip__label">{item.label}</span>
                <span class="evolution-slip__leaders" aria-hidden="true"></span>
                <span class="evolution-slip__date tabular">{item.date}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="evolution-slip__final">
        <p class="evolution-slip__final-text">
          Today: AI engineering, automation and agentic systems — direction recorded, evidence public, in progress.
        </p>
      </div>
    </div>
  </div>
</section>

<Comments locale={locale} copy={copy} path="evolution/" />

<style>
  .evolution-page {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .evolution-page__header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .evolution-page__heading {
    font-size: clamp(40px, 4.4vw, 68px);
    line-height: 1;
    font-weight: 400;
    margin: 0;
  }

  .evolution-page__intro {
    max-width: 30ch;
    font-size: var(--text-base);
    line-height: var(--leading-base);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* The slip: paper-coloured background with zigzag bottom edge */
  .evolution-page__slip {
    background-color: var(--color-surface);
    padding: var(--space-8);
    position: relative;
  }

  /* Zigzag bottom edge using clip-path */
  .evolution-page__slip::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    right: 0;
    height: 20px;
    background: linear-gradient(135deg, var(--color-surface) 33.33%, transparent 33.33%) 0 50%,
                linear-gradient(225deg, var(--color-surface) 33.33%, transparent 33.33%) 0 50%;
    background-size: 20px 20px;
    background-repeat: repeat-x;
  }

  .evolution-slip__phase {
    margin-bottom: var(--space-8);
  }

  .evolution-slip__phase:last-of-type {
    margin-bottom: var(--space-6);
  }

  .evolution-slip__phase-name {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }

  .evolution-slip__phase-range {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .evolution-slip__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evolution-slip__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .evolution-slip__label {
    flex: 1;
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  .evolution-slip__leaders {
    flex: 1;
    border-bottom: 1px dotted var(--color-text-muted);
    min-width: 2rem;
  }

  .evolution-slip__date {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* Final inverted row: paper text on ink bar */
  .evolution-slip__final {
    background-color: var(--color-text);
    color: var(--color-bg);
    padding: var(--space-4);
    margin-top: var(--space-6);
  }

  .evolution-slip__final-text {
    font-size: var(--text-base);
    line-height: var(--leading-base);
    margin: 0;
  }

  /* Desktop: heading and intro side by side */
  @media (min-width: 1024px) {
    .evolution-page__header {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .evolution-page__heading {
      grid-column: 1 / span 5;
    }

    .evolution-page__intro {
      grid-column: 7 / span 5;
      align-self: end;
    }

    .evolution-page__slip {
      grid-column: 7 / span 5;
    }
  }

  /* Phone: single column, reduced margins */
  @media (max-width: 767px) {
    .evolution-page__slip {
      padding: var(--space-6);
      margin-inline: calc(-1 * var(--space-4));
    }

    .evolution-slip__phase-name {
      font-size: var(--text-md);
    }

    .evolution-slip__label,
    .evolution-slip__date {
      font-size: var(--text-sm);
    }
  }
</style>
