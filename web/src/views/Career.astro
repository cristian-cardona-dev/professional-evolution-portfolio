---
/**
 * Career composition — "Two columns, highlighted words" (Task 6 redesign).
 *
 * The career page is a single statement in two justified columns with six or
 * seven flat-highlighted facts. The final highlighted sentence links to
 * contact. The timeline follows as a separate section.
 *
 * The statement is hardcoded from the copy-deck (Task 2 output). It is
 * editorial content, not data. The timeline below still reads from
 * `data/experience.json` via CareerTimeline.
 *
 * Heading order: h1 (page) → h2 (timeline) → h3 (company, from the component)
 * → h2 (skills) → h3 (category, from the matrix).
 */
import type { Copy, Locale } from '../i18n/copy';
import { canonicalUrl, route } from '../lib/urls';
import { profile, skills } from '../lib/data';
import CareerTimeline from '../components/CareerTimeline.astro';
import SkillMatrix from '../components/SkillMatrix.astro';
import Comments from '../components/Comments.astro';
import ShareRow from '../components/ShareRow.astro';
import AskAboutPage from '../components/AskAboutPage.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

const resumeHref = `${import.meta.env.BASE_URL}resume-${locale}.html`;
const resumePdfHref = `${import.meta.env.BASE_URL}resume-${locale}.pdf`;

const pageCanonical = canonicalUrl(locale, 'career/');

const guestbookHref = route(locale, 'guestbook/');

const askQuery = skills
  .filter((skill) => skill.projects.length > 0)
  .map((skill) => skill.name)
  .join(' ');

const availability = profile.availability;
const availabilityLabels: Record<string, string> = {
  available: copy.career.availability.available,
  busy: copy.career.availability.busy,
  unavailable: copy.career.availability.unavailable,
};
const availabilityText = availability ? availabilityLabels[availability.status] : null;
---

<section class="career-page" id="career" aria-labelledby="career-heading">
  <div class="shell">
    <header class="career-page__header reveal">
      <h1 id="career-heading" class="career-page__heading">
        {copy.career.pageHeading}
      </h1>
    </header>

    <div class="career-page__statement reveal">
      <p class="career-page__prose">
        {copy.career.statement.map((segment) =>
          segment.mark ? <mark>{segment.text}</mark> : <>{segment.text}</>
        )}
      </p>
      <p class="career-page__cta">
        <mark class="career-page__cta-mark">
          <a href={guestbookHref}>{copy.career.cta}</a>
        </mark>
      </p>
    </div>

    {
      availability && availabilityText && (
        <p class="career__availability" data-availability={availability.status}>
          <span class="career__availability-chip">
            <span class="career__availability-dot" aria-hidden="true" />
            <span class="visually-hidden">{copy.career.availability.label}: </span>
            {availabilityText}
          </span>
          {availability.note && <span class="career__availability-note">{availability.note}</span>}
          {availability.updated && (
            <span class="career__availability-date">
              {copy.career.availability.asOf(availability.updated)}
            </span>
          )}
        </p>
      )
    }

    <p class="career__resume">
      <a
        class="button button--primary career__resume-pdf"
        href={resumePdfHref}
        download={`resume-${locale}.pdf`}
      >
        {copy.career.resumePdf}
      </a>
      <a href={resumeHref} target="_blank" rel="noopener noreferrer">
        {copy.career.resume}
        <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
      </a>
    </p>

    <div class="career__share">
      <ShareRow copy={copy} url={pageCanonical?.href} />
      <AskAboutPage copy={copy} query={askQuery} />
      <a class="career__guestbook" href={guestbookHref}>{copy.career.guestbookCta}</a>
    </div>

    <div class="career-block">
      <h2 id="career-timeline-heading">{copy.career.timelineHeading}</h2>
      <CareerTimeline copy={copy} locale={locale} />
    </div>

    <section class="skills-block" id="skills" aria-labelledby="skills-heading">
      <div class="skills-block__head reveal">
        <h2 id="skills-heading">{copy.skills.heading}</h2>
        <p class="lead">{copy.skills.lead}</p>
      </div>

      <SkillMatrix copy={copy} locale={locale} />
    </section>
  </div>
</section>

<Comments locale={locale} copy={copy} path="career/" />

<style>
  .career-page {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .career-page__header {
    margin-bottom: var(--space-12);
  }

  .career-page__heading {
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.1;
    font-weight: 500;
    margin: 0;
  }

  .career-page__statement {
    max-width: 90ch;
    margin-bottom: var(--space-12);
  }

  .career-page__prose {
    font-size: clamp(22px, 2.1vw, 32px);
    line-height: 1.4;
    column-count: 2;
    column-gap: var(--space-8);
    text-align: justify;
    margin: 0 0 var(--space-6);
  }

  .career-page__prose mark {
    background-color: var(--color-accent-light);
    color: var(--color-text);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .career-page__cta {
    margin: 0;
    font-size: clamp(22px, 2.1vw, 32px);
    line-height: 1.4;
    column-count: 2;
    column-gap: var(--space-8);
    text-align: justify;
  }

  .career-page__cta-mark {
    background-color: var(--color-accent);
    color: var(--color-bg);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .career-page__cta-mark a {
    color: inherit;
    text-decoration: none;
  }

  .career-page__cta-mark a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Availability chip */
  .career__availability {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
  }

  .career__availability-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2rem var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .career__availability-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: var(--radius-full);
    background-color: var(--color-text-muted);
  }

  .career__availability[data-availability='available'] .career__availability-dot {
    background-color: var(--color-success);
  }

  .career__availability[data-availability='busy'] .career__availability-dot {
    background-color: var(--color-warn);
  }

  .career__availability-note {
    color: var(--color-text-muted);
  }

  .career__availability-date {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .career__resume {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .career__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-3);
  }

  .career__guestbook {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
  }

  .career-block > h2 {
    margin-bottom: var(--space-4);
  }

  .skills-block {
    margin-top: var(--space-16);
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }

  .skills-block__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .skills-block__head h2 {
    margin-bottom: var(--space-3);
  }

  /* Phone: one column */
  @media (max-width: 767px) {
    .career-page__prose,
    .career-page__cta {
      font-size: 20px;
      column-count: 1;
      text-align: left;
    }
  }
</style>
