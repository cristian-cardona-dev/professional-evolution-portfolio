---
/**
 * "How this site is built" — the artifact explaining itself.
 *
 * The portfolio's premise is that a claim should point at something
 * inspectable; this page turns that lens on the site itself. It states, in the
 * reader's language, what the site is built with, how it deploys, what the
 * assistant actually is and what data is deliberately not published — all from
 * `copy.build`, so no sentence about the build can drift from what the build
 * does.
 *
 * The only non-copy values are URLs: the public repository (from
 * `data/profile.json`) and the three official references the brief names
 * (astro.build, the GitHub Pages docs and the Cloudflare Workers docs). They are
 * constants here, like `SUGGESTION_ISSUE_URL` in `lib/urls.ts`, because a link
 * target never changes with the locale.
 *
 * Heading order: h1 (page) → h2 (stack, deployment, assistant, agent, source,
 * boundary) — no level is skipped.
 */
import type { Copy, Locale } from '../i18n/copy';
import { profile } from '../lib/data';
import Comments from '../components/Comments.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

const SOURCE_REPO = `https://github.com/${profile.reposOwner}/professional-evolution-portfolio`;
const ASTRO_URL = 'https://astro.build';
const GITHUB_PAGES_DOCS_URL = 'https://docs.github.com/pages';
const CLOUDFLARE_WORKERS_URL = 'https://developers.cloudflare.com/workers/';

/* The feed itself is locale-independent (English canonical data), so only the
   deployment base is needed. */
const rssHref = `${import.meta.env.BASE_URL}rss.xml`;
---

<section class="section" id="build" aria-labelledby="build-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.build.eyebrow}</p>
      <h1 id="build-heading">{copy.build.title}</h1>
      <p class="lead">{copy.build.summary}</p>
    </header>

    <section class="build-block reveal" aria-labelledby="build-stack-heading">
      <h2 id="build-stack-heading">{copy.build.stackHeading}</h2>
      <ul class="build-list">
        {copy.build.stackItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="build-block reveal" aria-labelledby="build-deploy-heading">
      <h2 id="build-deploy-heading">{copy.build.deployHeading}</h2>
      <p class="build-note">{copy.build.deployNote}</p>
      <p class="build-note">{copy.build.deployHeadersNote}</p>
    </section>

    <section class="build-block reveal" aria-labelledby="build-assistant-heading">
      <h2 id="build-assistant-heading">{copy.build.assistantHeading}</h2>
      <p class="build-note">{copy.build.assistantNote}</p>
    </section>

    <section class="build-block reveal" aria-labelledby="build-agent-heading">
      <h2 id="build-agent-heading">{copy.build.agentHeading}</h2>
      <p class="build-note">{copy.build.agentNote}</p>
    </section>

    <section class="build-block reveal" aria-labelledby="build-source-heading">
      <h2 id="build-source-heading">{copy.build.sourceHeading}</h2>
      <p class="build-note">{copy.build.sourceNote}</p>
      <ul class="build-links">
        <li>
          <a href={SOURCE_REPO} target="_blank" rel="noopener noreferrer">
            {copy.build.repoLabel}
            <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
          </a>
        </li>
        <li>
          <a href={rssHref}>{copy.build.rssLabel}</a>
        </li>
      </ul>
    </section>

    {/* The boundary is rendered with the same panel shape as the honest empty
        states elsewhere, so "what is not published" reads as a boundary rather
        than as another feature. */}
    <section class="build-block" aria-labelledby="build-boundary-heading">
      <h2 id="build-boundary-heading">{copy.build.boundaryHeading}</h2>
      <p class="state-panel build-boundary">{copy.build.boundaryNote}</p>
    </section>

    <div class="build-credits reveal">
      <p class="build-credits__line">{copy.build.credits}</p>
      <ul class="build-credits__links">
        <li>
          <a href={ASTRO_URL} target="_blank" rel="noopener noreferrer">
            astro.build
            <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
          </a>
        </li>
        <li>
          <a href={GITHUB_PAGES_DOCS_URL} target="_blank" rel="noopener noreferrer">
            docs.github.com/pages
            <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
          </a>
        </li>
        <li>
          <a href={CLOUDFLARE_WORKERS_URL} target="_blank" rel="noopener noreferrer">
            developers.cloudflare.com/workers
            <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<Comments locale={locale} copy={copy} path="build/" />

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-12);
  }

  .section__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .build-block {
    max-width: 68ch;
    margin-top: var(--space-10);
  }

  .build-block h2 {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    margin-bottom: var(--space-3);
  }

  .build-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .build-list li {
    position: relative;
    max-width: none;
    padding-left: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* Decorative marker: the list is already a `<ul>`, so the semantics are
     carried by the markup and the dot only reinforces the grouping. */
  .build-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .build-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .build-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .build-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .build-boundary {
    margin-top: var(--space-2);
  }

  .build-credits {
    max-width: 68ch;
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .build-credits__line {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .build-credits__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .build-credits__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
</style>
