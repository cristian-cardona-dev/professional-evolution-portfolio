---
/**
 * Home composition — hero → selected work → career → evolution preview →
 * evidence teaser → boundaries → contact → suggestions.
 *
 * The markup is shared by `/` and `/es/`: `locale` picks the catalog and the
 * URL helpers build every internal link, so both routes render the exact same
 * structure with copy from `i18n/copy.ts`. That is what keeps the two homes
 * from drifting — there is one file to edit, not two.
 *
 * Section ids keep the preserved anchors: #projects, #career, #evolution,
 * #evidence, #boundaries and #contact (the header nav uses them while it is not
 * pointing at a route). The reveal observer itself lives in BaseLayout, so it
 * is not repeated here.
 *
 * The evolution section ends with a link to `/evolution/#roadmap` rather than a
 * preview of the goal → skill → proof table: a three-column table is not a
 * teaser, and three of its rows would read as the whole plan.
 *
 * Two blocks exist to make a claim inspectable rather than to sell it: the
 * career timeline (declared periods, with the provenance badge on every entry)
 * and the boundaries list (what this portfolio refuses to assert). Both come
 * from copy; neither may gain an item that no data file backs.
 */
import type { Copy, Locale } from '../i18n/copy';
import type { Milestone, Project } from '../lib/data';
import {
  curatedMilestonesByDateDesc,
  evidence,
  experienceCompanies,
  getProjectBySlug,
  milestones,
  projects,
} from '../lib/data';
import { route } from '../lib/urls';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import SkillMatrix from '../components/SkillMatrix.astro';
import EvolutionTimeline from '../components/EvolutionTimeline.astro';
import ContactForm from '../components/ContactForm.astro';
import NotesFeed from '../components/NotesFeed.astro';
import SuggestionsPanel from '../components/SuggestionsPanel.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

const FEATURED_SLUGS = [
  'professional-evolution-portfolio',
  'ai-automation-workflow-lab',
  'ai-chat-app',
];

const featured = FEATURED_SLUGS.map((slug) => getProjectBySlug(slug)).filter(
  (project): project is Project => project !== undefined,
);

/** Honest by construction: zero published items renders the explanation. */
const evidenceCount = evidence.items.length;

/**
 * Home preview: three curated milestones, status-first. A git-derived entry is
 * an unreviewed candidate (its own badge says so), so it is never in the
 * preview; and within the curated set, delivered work leads: shipped →
 * in-progress → planned, newest first inside each status. Sorting happens on a
 * copy in this view — `data/evolution.json` stays the canonical ordering and
 * is not mutated — so the preview never opens on a stated intention when a
 * shipped milestone exists. The timeline component's own note tells the
 * reader the preview is curated.
 */
const STATUS_ORDER: Record<Milestone['status'], number> = {
  shipped: 0,
  'in-progress': 1,
  planned: 2,
};

const evolutionPreview = [...curatedMilestonesByDateDesc]
  .sort((a, b) => {
    const byStatus = STATUS_ORDER[a.status] - STATUS_ORDER[b.status];
    if (byStatus !== 0) return byStatus;
    return a.date === b.date ? a.id.localeCompare(b.id) : a.date < b.date ? 1 : -1;
  })
  .slice(0, 3);

/**
 * Verified metrics — counted from the canonical data at build time, never
 * hardcoded. The company figures come from the career dataset through
 * `lib/data.ts`, the same source `CareerTimeline` renders. The "public" project
 * count covers the statuses that name an inspectable artifact (`live`,
 * `prototype`, `lab`), matching the site's own claim vocabulary.
 */
const PUBLIC_PROJECT_STATUSES: Project['status'][] = ['live', 'prototype', 'lab'];

const companyCount = experienceCompanies.length;
const sinceYear = Math.min(
  ...experienceCompanies.map((company) => Number(company.start.slice(0, 4))),
);
const publicProjectCount = projects.filter((entry) =>
  PUBLIC_PROJECT_STATUSES.includes(entry.status),
).length;
const milestoneCount = milestones.length;
---

<Hero copy={copy} />

{/* Verified metrics — hero-adjacent, and every figure is counted from the
    canonical data at build time (see the counts in the frontmatter above). */}
<section class="section section--metrics" aria-labelledby="metrics-heading">
  <div class="shell">
    <h2 class="metrics__heading" id="metrics-heading">{copy.metrics.heading}</h2>
    <ul class="metrics">
      <li class="metrics__item">{copy.metrics.companies(companyCount, sinceYear)}</li>
      <li class="metrics__item">{copy.metrics.projects(publicProjectCount)}</li>
      <li class="metrics__item">{copy.metrics.milestones(milestoneCount)}</li>
      <li class="metrics__item">{copy.metrics.locales}</li>
    </ul>
  </div>
</section>

<section class="section" id="projects" aria-labelledby="projects-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.work.eyebrow}</p>
      <h2 id="projects-heading">{copy.work.heading}</h2>
      <p class="lead">{copy.work.summary}</p>
    </header>

    <ul class="project-grid">
      {
        featured.map((project, index) => (
          <li class="project-grid__item">
            <ProjectCard
              copy={copy}
              locale={locale}
              project={project}
              revealIndex={index}
              priority={index === 0}
            />
          </li>
        ))
      }
    </ul>

    <p class="section__more reveal">
      <a class="button button--ghost" href={route(locale, 'work/')}>{copy.work.viewAll}</a>
    </p>
  </div>
</section>

<section class="section" id="career" aria-labelledby="career-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.career.eyebrow}</p>
      <h2 id="career-heading">{copy.career.heading}</h2>
      <p class="lead">{copy.career.summary}</p>
    </header>

    {/* Compact: the same entries, periods, bars, stacks and source badge as
        `/career/`, with the link to the full page instead of the older roles. */}
    <CareerTimeline copy={copy} locale={locale} compact />

    {/* The skill matrix preview lives inside this section rather than as its
        own top-level block: the categories are the vocabulary of the timeline
        above them, so splitting them would make the reader scroll past the
        evidence before seeing what it describes. `aria-labelledby` points at
        the h3, keeping the outline h2 (section) → h3 (timeline companies from
        the component) → h3 (skills preview). */}
    <section class="skills-preview reveal" aria-labelledby="home-skills-heading">
      <h3 class="skills-preview__heading" id="home-skills-heading">{copy.skills.heading}</h3>
      <p class="skills-preview__lead">{copy.skills.lead}</p>
      <SkillMatrix copy={copy} locale={locale} compact />
    </section>
  </div>
</section>

<section class="section" id="evolution" aria-labelledby="evolution-heading">
  <div class="shell">
    <header class="section__head reveal">
      <p class="eyebrow">{copy.evolution.eyebrow}</p>
      <h2 id="evolution-heading">{copy.evolution.heading}</h2>
      <p class="lead">{copy.evolution.summary}</p>
    </header>

    <EvolutionTimeline
      copy={copy}
      locale={locale}
      milestones={evolutionPreview}
      limit={3}
      previewNote={copy.evolution.curatedPreviewNote}
    />

    {/* The roadmap itself is not previewed here. A three-column goal table is
        not a teaser: rendering three of its rows would read as the whole plan,
        and the phases column carries no meaning once the rows are cut. The home
        page links to the roadmap instead, at the anchor `/evolution/#roadmap`
        that page gives it. */}
    <p class="section__more reveal">
      <a class="button button--ghost" href={`${route(locale, 'evolution/')}`}>
        {copy.evolution.roadmapTable.viewAll}
      </a>
    </p>
  </div>
</section>

{/* Notes: a dated feed of the most recent hand-written milestones, placed
    after the evolution/roadmap area it continues and before the evidence
    teaser and the closing boundary statement. It is curated-only, so the
    unreviewed git candidates stay on `/evolution/`; `#notes` is a section
    anchor only — the header nav does not gain a sixth item for it. */}
<NotesFeed copy={copy} locale={locale} />

<section class="section section--teaser" id="evidence" aria-labelledby="evidence-heading">
  <div class="shell evidence-teaser reveal">
    <p class="eyebrow">{copy.evidence.eyebrow}</p>
    <h2 id="evidence-heading">{copy.evidence.heading}</h2>
    <p class="lead">{copy.evidence.summary}</p>

    <p class="evidence-teaser__count tabular">{copy.evidence.count(evidenceCount)}</p>

    {evidenceCount === 0 && <p class="evidence-teaser__empty">{copy.evidence.empty}</p>}

    <p>
      <a class="button button--ghost" href={route(locale, 'evidence/')}>{copy.evidence.viewAll}</a>
    </p>
  </div>
</section>

{/* Boundaries: the closing statement of what this portfolio will not claim.
    It sits where the legacy site put it — after the evidence work and before
    the contact CTA — so the last thing a visitor reads before getting in touch
    is the list of things the author refuses to assert. Every line comes from
    `copy.boundaries`; nothing here is generated from the datasets. */}
<section class="section section--boundary" id="boundaries" aria-labelledby="boundaries-heading">
  <div class="shell">
    <div class="boundaries reveal">
      <p class="eyebrow">{copy.boundaries.eyebrow}</p>
      <h2 id="boundaries-heading">{copy.boundaries.heading}</h2>

      <ul class="boundaries__list">
        {copy.boundaries.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<ContactForm copy={copy} />

<SuggestionsPanel copy={copy} />

<style>
  .section {
    padding-block: var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section--teaser {
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  /* --- Verified metrics ------------------------------------------------------
   * A compact strip directly under the hero: four build-time counts. It is a
   * plain list of captions, so there is no separate number styling that could
   * drift from the data behind it. The tighter block padding keeps it reading
   * as a band attached to the hero rather than as a new section.
   * --------------------------------------------------------------------- */
  .section--metrics {
    padding-block: var(--space-8);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .metrics__heading {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .metrics {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metrics__item {
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* --- Boundaries ----------------------------------------------------------
   * A tinted band rather than another card: it is a statement about the site,
   * not one more claim it is making, so it reads as a boundary rather than as
   * content to skim past.
   * --------------------------------------------------------------------- */
  .section--boundary {
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .boundaries {
    max-width: 68ch;
  }

  .boundaries h2 {
    margin-block: var(--space-2) var(--space-6);
  }

  .boundaries__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .boundaries__list li {
    position: relative;
    max-width: none;
    padding-left: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* The dot is decorative: the list is already a `<ul>`, so it carries the
     semantics on its own and assistive tech gains nothing from the marker. */
  .boundaries__list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .section__head h2 {
    margin-block: var(--space-2) var(--space-3);
  }

  /* --- Skills preview --------------------------------------------------------
   * A subsection of the career section, separated by a hairline rather than a
   * second heading band, so it reads as part of the same story (what was done,
   * and with what) instead of competing with the timeline above it.
   * --------------------------------------------------------------------- */
  .skills-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .skills-preview__heading {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .skills-preview__lead {
    max-width: var(--measure);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .project-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-grid__item {
    display: flex;
  }

  .section__more {
    margin-top: var(--space-8);
  }

  .evidence-teaser__count {
    margin-top: var(--space-6);
    color: var(--color-accent);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-lg);
  }

  .evidence-teaser__empty {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

