---
/**
 * Evidence composition — "Names as one sentence" (Task 6 redesign).
 *
 * The evidence page is a single run-on sentence listing all evidence names.
 * Each name is highlighted in sequence, cycling every 2s. The sentence ends
 * with a full stop.
 *
 * The heading is "Checked against" (2-3 words). The sentence is statement size
 * (≤36px), three lines desktop. 120px above and below. No logos, no columns.
 *
 * Every name is a real artefact from the evidence dataset. The phone version
 * cuts to the 12 strongest names.
 */
import type { Copy, Locale } from '../i18n/copy';
import { evidence } from '../lib/data';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

/**
 * Evidence names from the copy-deck. These are hardcoded editorial content.
 * Every name is a real artefact from the evidence dataset.
 */
const evidenceNames = [
  'the AI reliability lab repository',
  'the cloud dashboard repository',
  'the automation workflow lab repository',
  "this portfolio's public build",
  'the public snapshot contract',
  'three case studies with explicit boundaries',
  'evidence records ev-ai-reliability-lab-repository',
  'ev-cloud-dashboard-repository',
  'ev-ai-automation-workflow-repository',
  'the commit history of every milestone',
  'the LinkedIn profile',
  'the GitHub activity snapshot',
];
---

<section class="evidence-page" id="evidence" aria-labelledby="evidence-heading">
  <div class="shell">
    <h1 id="evidence-heading" class="evidence-page__heading">Checked against</h1>

    <p class="evidence-page__sentence">
      {evidenceNames.map((name, index) => (
        <span
          class="evidence-page__name"
          style={`--index: ${index}; --total: ${evidenceNames.length}`}
        >
          {name}{index < evidenceNames.length - 1 ? ', ' : '.'}
        </span>
      ))}
    </p>
  </div>
</section>

<style>
  .evidence-page {
    padding-block: 120px 120px;
    scroll-margin-top: var(--header-height);
  }

  .evidence-page__heading {
    font-size: var(--text-base);
    line-height: var(--leading-base);
    font-weight: 400;
    margin: 0 0 var(--space-8);
  }

  .evidence-page__sentence {
    font-size: clamp(24px, 3.6vw, 36px);
    line-height: 1.3;
    max-width: 68ch;
    margin: 0;
  }

  .evidence-page__name {
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    animation: highlight-cycle calc(var(--total) * 2s) infinite;
    animation-delay: calc(var(--index) * 2s);
  }

  @keyframes highlight-cycle {
    0%, 8.33%, 100% {
      color: var(--color-text-muted);
    }
    4.17%, 12.5% {
      color: var(--color-text);
      font-weight: 500;
    }
  }

  /* Phone: reduce font size */
  @media (max-width: 767px) {
    .evidence-page {
      padding-block: 80px 80px;
    }

    .evidence-page__sentence {
      font-size: clamp(20px, 5vw, 28px);
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .evidence-page__name {
      animation: none;
      color: var(--color-text);
    }
  }
</style>
