---
/**
 * Evidence composition — "Names as one sentence" (Task 6 redesign).
 *
 * The evidence page is a single run-on sentence listing all evidence names.
 * Each name is highlighted in sequence, cycling every 2s. The sentence ends
 * with a full stop. Each evidence item is followed by an EvidenceBadge showing
 * its status (demonstrated, developing, etc.).
 *
 * The heading is "Checked against" (2-3 words). The sentence is statement size
 * (≤36px), three lines desktop. 120px above and below. No logos, no columns.
 *
 * Every name is a real artefact from the evidence dataset (data/evidence.json).
 */
import type { Copy, Locale, ClaimStatus } from '../i18n/copy';
import { evidence } from '../lib/data';
import EvidenceBadge from '../components/EvidenceBadge.astro';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;

/**
 * Evidence items from the dataset. Each has a label, URL, and status.
 * The status determines the EvidenceBadge variant (demonstrated, developing, etc.).
 */
const evidenceItems = evidence.items.map((item) => ({
  label: item.label,
  url: item.url,
  status: item.status as ClaimStatus,
}));
---

<section class="evidence-page" id="evidence" aria-labelledby="evidence-heading">
  <div class="shell">
    <h1 id="evidence-heading" class="evidence-page__heading">{copy.evidence.pageHeading}</h1>

    <p class="evidence-page__sentence">
      {evidenceItems.map((item, index) => (
        <span
          class="evidence-page__item"
          style={`--index: ${index}; --total: ${evidenceItems.length}`}
        >
          <a href={item.url} class="evidence-page__name" target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
          <EvidenceBadge status={item.status} copy={copy} />
          {index < evidenceItems.length - 1 ? ', ' : '.'}
        </span>
      ))}
    </p>
  </div>
</section>

<style>
  .evidence-page {
    padding-block: 120px 120px;
    scroll-margin-top: var(--header-height);
  }

  .evidence-page__heading {
    font-size: var(--text-base);
    line-height: var(--leading-base);
    font-weight: 400;
    margin: 0 0 var(--space-8);
  }

  .evidence-page__sentence {
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.5;
    max-width: 80ch;
    margin: 0;
  }

  .evidence-page__item {
    display: inline;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    animation: highlight-cycle calc(var(--total) * 2s) infinite;
    animation-delay: calc(var(--index) * 2s);
  }

  .evidence-page__name {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }

  .evidence-page__name:hover {
    text-decoration-color: var(--color-text);
  }

  .evidence-page__item :global(.evidence-badge) {
    font-size: 0.75em;
    vertical-align: baseline;
    margin-inline: 0.3em 0.5em;
  }

  @keyframes highlight-cycle {
    0%, 8.33%, 100% {
      color: var(--color-text-muted);
    }
    4.17%, 12.5% {
      color: var(--color-text);
      font-weight: 500;
    }
  }

  /* Phone: reduce font size and spacing */
  @media (max-width: 767px) {
    .evidence-page {
      padding-block: 80px 80px;
    }

    .evidence-page__sentence {
      font-size: clamp(16px, 4vw, 22px);
    }

    .evidence-page__item :global(.evidence-badge) {
      font-size: 0.7em;
      margin-inline: 0.2em 0.4em;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .evidence-page__item {
      animation: none;
      color: var(--color-text);
    }
  }
</style>
