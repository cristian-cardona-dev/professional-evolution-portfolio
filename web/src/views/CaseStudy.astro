---
/**
 * Case-study composition — one project plus the case study derived from
 * `case-studies/*.md` by `scripts/case-studies-sync.mjs`.
 *
 * Shared by `/work/<slug>/` and `/es/work/<slug>/`, exactly like the other
 * views: `locale` picks the copy catalog and builds every internal link.
 *
 * Content rules:
 *   - The name, status, repository and summary come from `data/projects.json`
 *     (the es locale reads `summary_es` when the dataset publishes one).
 *   - Section bodies come from `data/case-studies.json` and are rendered
 *     through `renderSectionBody` (escape first, then bold + links only — no
 *     HTML passthrough). The canonical `sections` are English; the reviewed
 *     `sections_es` (from `case-studies/<slug>.es.md`) is the Spanish
 *     translation of that same evidence and is what the es locale renders.
 *   - The source H1 shown as provenance (`.case-study__source-title`) is
 *     localized the same way: the es locale reads `title_es` (the H1 of the
 *     same companion file) and falls back to the English `title`.
 *   - The first two sections (classification, problem/context) are always
 *     visible; everything after them sits behind one `<details>` disclosure
 *     labelled from `copy.caseStudy.disclosure`.
 *   - A project with no case study gets the honest empty state and its
 *     repository link — never an invented write-up.
 *
 * Heading order: h1 (project) → h2 (sections, related, CTA) → h3 (cards).
 */
import type { Copy, Locale } from '../i18n/copy';
import type { Project } from '../lib/data';
import { caseStudyFor, relatedProjects } from '../lib/data';
import { renderSectionBody } from '../lib/markdown';
import { canonicalUrl, route, sectionHref, SUGGESTION_ISSUE_URL } from '../lib/urls';
import ProjectCard from '../components/ProjectCard.astro';
import Comments from '../components/Comments.astro';
import ShareRow from '../components/ShareRow.astro';
import AskAboutPage from '../components/AskAboutPage.astro';
import CopyAnchor from '../components/CopyAnchor.astro';

interface Props {
  locale: Locale;
  copy: Copy;
  project: Project;
}

const { locale, copy, project } = Astro.props;

const study = caseStudyFor(project.slug);

/**
 * The source H1 of the markdown, shown verbatim as provenance
 * (`.case-study__source-title`).
 *
 * The es locale reads the reviewed `title_es` when the study publishes one
 * (the H1 of `case-studies/<slug>.es.md`); otherwise — and always on en — it
 * falls back to the canonical English `title`, exactly like `summary_es` and
 * `sections_es`.
 *
 * The document `<title>`/`og:title` are NOT derived from this: the route pages
 * build them from `project.name` + `copy.caseStudy.eyebrow`, so those head
 * surfaces are byte-identical in both locales by construction.
 */
const sourceTitle = study
  ? locale === 'es' && study.title_es
    ? study.title_es
    : study.title
  : null;

/**
 * Section bodies in the page's locale.
 *
 * The es locale reads the reviewed `sections_es` when the study publishes one
 * (derived from `case-studies/<slug>.es.md`, the same shape as `sections`);
 * otherwise — and always on en — it falls back to the canonical English
 * sections, exactly like `summary_es` on the project summary. The two locales
 * mirror 1:1, which `data-validate.mjs` enforces.
 *
 * Anchors stay `case-study-section-<index>`, derived from the section position
 * and never from the heading text, so the id set is identical in both locales
 * even though the headings are translated.
 */
const sections = study
  ? locale === 'es' && study.sections_es
    ? study.sections_es
    : study.sections
  : [];
/** Sections 1–2 (classification / problem) stay open. */
const visibleSections = sections.slice(0, 2);
/** Everything else is progressive disclosure. */
const disclosedSections = sections.slice(2);
const hasContent = visibleSections.length > 0;

/**
 * Table-of-contents entries — one per section, in reading order.
 *
 * `id` is the position-derived anchor the headings already carry
 * (`case-study-section-<index>`), reused verbatim and never re-derived from
 * the heading text: EN and ES translate the headings, so a text-derived id
 * would differ per locale and break every shared or copied link. `heading` is
 * the label the reader sees, in the page's locale — the same string the
 * section itself renders as its `<h2>`.
 */
const tocItems = sections.map((section, index) => ({
  id: `case-study-section-${index}`,
  heading: section.heading,
}));

const related = relatedProjects(project.slug);

/**
 * Spanish pages read the reviewed `summary_es` when the dataset publishes one,
 * exactly like `ProjectCard`; every other locale keeps `summary`.
 */
const summary = locale === 'es' && project.summary_es ? project.summary_es : project.summary;

/** Same status→colour mapping the project card uses (see ProjectCard.astro). */
const statusVariant: Record<Project['status'], string> = {
  live: 'chip--success',
  mvp: 'chip--accent',
  demo: 'chip--accent',
  prototype: 'chip--warn',
  lab: 'chip--neutral',
};

const backHref = route(locale, 'work/');
/** Base-aware: from this page it resolves to `<locale root>#contact`. */
const contactHref = sectionHref(locale, 'contact', Astro.url.pathname);

/**
 * The canonical URL of this case study, on the Pages origin — the same value
 * `BaseLayout` publishes in `<link rel="canonical">`, read from the one
 * shared computation in `lib/urls.ts` so the share intents below can never
 * advertise a different host than the page itself does.
 */
const pageCanonical = canonicalUrl(locale, `work/${project.slug}/`);

/**
 * Seed query of the "ask about this page" deep link
 * (`components/AskAboutPage.astro`): the page's own title and its declared
 * keywords, exactly as this page renders them. English by design — the
 * canonical datasets are English and the assistant's published index is
 * English-only — so the `es` page seeds the same words and matches the same
 * entries. The button only seeds; the widget runs its own search, so a seed
 * that matched nothing would still show the honest fallback.
 */
const askQuery = [project.name, ...project.tags].join(' ');
---

<article class="case-study">
  <header class="case-study__hero">
    <div class="shell shell--narrow">
      <p class="case-study__back reveal">
        <a href={backHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M19 12H5M11 6l-6 6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          {copy.caseStudy.back}
        </a>
      </p>

      <div class="case-study__intro reveal">
        <p class="eyebrow">{copy.caseStudy.eyebrow}</p>
        <h1>{project.name}</h1>

        <div class="case-study__meta">
          <span
            class={`chip ${statusVariant[project.status]}`}
            title={copy.projectStatus.hint[project.status]}
          >
            {copy.projectStatus.label[project.status]}
            <span class="visually-hidden">. {copy.projectStatus.hint[project.status]}</span>
          </span>

          <a class="case-study__repo" href={project.repo} target="_blank" rel="noopener noreferrer">
            {copy.work.repo}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
          </a>
        </div>

        {/* One natural home for "send this page to somebody else": the header
            of the page a reader would share. The share row keeps the E1b
            copy-link control — same `button[data-copy]` + `data-copy-canonical`
            contract, same canonical value read from `<link rel="canonical">`
            by `lib/clipboard.ts` — and adds the two plain-anchor share
            intents beside it (no third-party script). The URL those intents
            advertise comes from `canonicalUrl()`, the same helper BaseLayout
            uses for the canonical tag, so the Workers mirror can never share
            its own origin. The control itself follows the shared
            copy-control contract in global.css. */}
        <div class="case-study__share">
          <ShareRow copy={copy} url={pageCanonical?.href} />
          <AskAboutPage copy={copy} query={askQuery} />
        </div>

        {
          sourceTitle && (
            <p class="case-study__source-title">{sourceTitle}</p>
          )
        }

        <p class="lead">{summary}</p>
      </div>
    </div>
  </header>

  <div class="shell case-study__main">
    {
      hasContent ? (
        <>
          {/* Sticky table of contents. On a wide viewport it is the sticky
              sidebar of the two-column body; below 1024px it is a compact
              disclosure above the text. The list is rendered open in the
              markup so a no-JS visit keeps every section reachable — the same
              progressive-enhancement contract as the site header: `html.js`
              (set pre-paint by BaseLayout) is what enables the collapsed
              state, and the toggle only flips `aria-expanded` plus the
              `data-open` marker the scoped CSS keys off. The label is the
              localized `a11y.onThisPage`, which is also the landmark's
              accessible name. */}
          <nav class="case-study__toc" aria-label={copy.a11y.onThisPage} data-toc>
            <p class="eyebrow case-study__toc-heading">{copy.a11y.onThisPage}</p>

            <button
              type="button"
              class="case-study__toc-toggle"
              aria-expanded="false"
              aria-controls="case-study-toc-list"
              data-toc-toggle
            >
              <span>{copy.a11y.onThisPage}</span>
              <span class="case-study__toc-chevron" aria-hidden="true"></span>
            </button>

            <ul class="case-study__toc-list" id="case-study-toc-list">
              {tocItems.map((item) => (
                <li>
                  <a class="case-study__toc-link" href={`#${item.id}`} data-toc-link={item.id}>
                    {item.heading}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="case-study__body">
            {visibleSections.map((section, index) => (
              <section
                class="case-study__section"
                aria-labelledby={`case-study-section-${index}`}
                data-toc-section={`case-study-section-${index}`}
              >
                <div class="case-study__section-head">
                  <h2 id={`case-study-section-${index}`}>{section.heading}</h2>
                  <CopyAnchor copy={copy} sectionId={`case-study-section-${index}`} />
                </div>
                <div class="case-study__text" set:html={renderSectionBody(section.body)} />
              </section>
            ))}

            {disclosedSections.length > 0 && (
              <details class="disclosure">
                <summary class="disclosure__summary">{copy.caseStudy.disclosure}</summary>
                <div class="disclosure__body">
                  {disclosedSections.map((section, offset) => {
                    const index = visibleSections.length + offset;
                    return (
                      <section
                        class="case-study__section"
                        aria-labelledby={`case-study-section-${index}`}
                        data-toc-section={`case-study-section-${index}`}
                      >
                        <div class="case-study__section-head">
                          <h2 id={`case-study-section-${index}`}>{section.heading}</h2>
                          <CopyAnchor copy={copy} sectionId={`case-study-section-${index}`} />
                        </div>
                        <div class="case-study__text" set:html={renderSectionBody(section.body)} />
                      </section>
                    );
                  })}
                </div>
              </details>
            )}
          </div>
        </>
      ) : (
        <div class="state-panel">
          <p>{copy.caseStudy.empty}</p>
          <p>
            <a class="button button--ghost" href={project.repo} target="_blank" rel="noopener noreferrer">
              {copy.work.repo}
              <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
            </a>
          </p>
        </div>
      )
    }
  </div>

  <section class="case-study__related" aria-labelledby="case-study-related-heading">
    <div class="shell">
      <div class="case-study__related-head reveal">
        <p class="eyebrow">{copy.work.eyebrow}</p>
        <h2 id="case-study-related-heading">{copy.work.related}</h2>
      </div>

      {
        related.length > 0 ? (
          <ul class="case-study__related-grid">
            {related.map((item, index) => (
              <li class="case-study__related-item">
                <ProjectCard copy={copy} locale={locale} project={item} revealIndex={index} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="case-study__related-empty">{copy.work.relatedEmpty}</p>
        )
      }
    </div>
  </section>

  <section class="case-study__cta" aria-labelledby="case-study-cta-heading">
    <div class="shell shell--narrow case-study__cta-inner reveal">
      <div class="case-study__cta-text">
        <p class="eyebrow">{copy.contact.eyebrow}</p>
        <h2 id="case-study-cta-heading">{copy.caseStudy.ctaHeading}</h2>
      </div>

      <div class="case-study__cta-actions">
        <a class="button button--primary" href={contactHref}>{copy.caseStudy.ctaContact}</a>
        <a
          class="button button--ghost"
          href={SUGGESTION_ISSUE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.suggestions.cta}
          <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
        </a>
        <p class="case-study__cta-note">{copy.suggestions.note}</p>
      </div>
    </div>
  </section>
</article>

<Comments locale={locale} copy={copy} path={`work/${project.slug}/`} />

<script>
  // Case-study table of contents: the mobile disclosure, the scroll-spy and
  // the deep-link repair. Every behaviour is an enhancement — the list is
  // rendered open, the links are plain anchors, and nothing here is required
  // to read the page.
  const toc = document.querySelector('[data-toc]');
  const tocToggle = document.querySelector('[data-toc-toggle]');

  // 1. Disclosure (mobile only; the CSS hides the button from 1024px up).
  // Same contract as the header menu: `aria-expanded` on the button plus a
  // `data-open` marker the scoped CSS keys off, and no focus trap because the
  // list sits in DOM order right after the button.
  if (toc instanceof HTMLElement && tocToggle instanceof HTMLButtonElement) {
    tocToggle.addEventListener('click', () => {
      const open = tocToggle.getAttribute('aria-expanded') !== 'true';
      tocToggle.setAttribute('aria-expanded', String(open));
      if (open) toc.setAttribute('data-open', '');
      else toc.removeAttribute('data-open');
    });
  }

  // Close the disclosure again when the reader picks a section: on a narrow
  // viewport the open list would otherwise sit between them and the section
  // they just chose. It runs after `revealTarget` (the ancestor `<details>`
  // must open first) and after the click has been dispatched, so the default
  // anchor navigation is unaffected. On wide viewports the button is hidden
  // and `data-open` is inert, so the same call is a no-op there.
  const collapseToc = () => {
    if (toc instanceof HTMLElement && tocToggle instanceof HTMLButtonElement) {
      tocToggle.setAttribute('aria-expanded', 'false');
      toc.removeAttribute('data-open');
    }
  };

  // 2. Sections 3+ live inside the progressive-disclosure `<details>`, whose
  // content is not rendered while closed. A TOC click — or a deep link, which
  // is exactly what the copy-anchor button produces — therefore has to open
  // every closed ancestor first, or the browser would scroll to an anchor
  // nobody can see. Runs before the default anchor navigation, so the section
  // is already rendered when the browser scrolls to it.
  const revealTarget = (id: string | undefined) => {
    const target = id ? document.getElementById(id) : null;
    for (let node = target?.parentElement ?? null; node; node = node.parentElement) {
      if (node instanceof HTMLDetailsElement && !node.open) node.open = true;
    }
  };

  for (const link of document.querySelectorAll<HTMLElement>('[data-toc-link]')) {
    link.addEventListener('click', () => {
      revealTarget(link.dataset.tocLink);
      collapseToc();
    });
  }

  // A shared or copied URL arrives with the fragment already set.
  const revealFromHash = () => revealTarget(window.location.hash.slice(1));
  revealFromHash();
  window.addEventListener('hashchange', revealFromHash);

  // 3. Scroll-spy: the same IntersectionObserver pattern as the header nav
  // (Header.astro) — one thin band in the middle of the viewport, the first
  // section in document order that sits in it wins, and only our own `true`
  // value is ever cleared. Sections inside a closed `<details>` are ignored:
  // they are not rendered, so they cannot be "the section you are reading".
  const tocLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-link]'));
  const tocSections = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-section]'));

  if (tocLinks.length > 0 && tocSections.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<string>();

    const paint = () => {
      const current = tocSections.find((section) => visible.has(section.dataset.tocSection ?? ''));
      for (const link of tocLinks) {
        const isCurrent =
          current !== undefined && link.dataset.tocLink === current.dataset.tocSection;
        if (isCurrent) link.setAttribute('aria-current', 'true');
        else if (link.getAttribute('aria-current') === 'true') link.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          const key = target.dataset.tocSection;
          if (!key) continue;
          const disclosedAway = target.closest('details:not([open])') !== null;
          if (entry.isIntersecting && !disclosedAway) visible.add(key);
          else visible.delete(key);
        }
        paint();
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );

    tocSections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .case-study {
    display: block;
  }

  /* --- Hero-lite ------------------------------------------------------------ */
  .case-study__hero {
    padding-block: var(--space-8) var(--space-12);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .case-study__back {
    margin-bottom: var(--space-6);
  }

  .case-study__back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .case-study__back a:hover {
    color: var(--color-accent);
  }

  .case-study__back svg {
    width: 16px;
    height: 16px;
  }

  .case-study__intro h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .case-study__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-4);
  }

  /* The share row replaces the old inline copy button: it now carries the
     copy control AND the two share intents, so it gets the meta row's own
     bottom spacing before the source title / lead. The "ask about this page"
     button sits beside it as a page-level action of the same rank, and the
     slightly wider column gap marks it as a separate group from the share
     actions. (`--space-4` keeps the tighter action gap; `--space-5` is the
     wider layout step.) */
  .case-study__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .case-study__repo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .case-study__repo svg {
    width: 13px;
    height: 13px;
  }

  /* The H1 of the source markdown: it carries the boundary wording of the
     original document ("public reproduction" / "reproducción pública"), so it
     is shown verbatim — in the page's locale, via `title_es` on es. */
  .case-study__source-title {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* --- Body ---------------------------------------------------------------- */
  /* One column below 1024px (the TOC sits above the text as a compact
     disclosure); from 1024px up, a two-column grid whose left column is the
     sticky table of contents. The text column keeps the 760px cap the narrow
     shell used to provide, so the reading measure does not change, and the
     whole grid is centred inside the wider shell. */
  .case-study__main {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12) var(--space-8);
  }

  /* The honest empty state has no sections to list, so it spans the grid. */
  .case-study__main > .state-panel {
    grid-column: 1 / -1;
  }

  .case-study__body {
    display: block;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .case-study__main {
      grid-template-columns: 12rem minmax(0, 760px);
      justify-content: center;
      gap: var(--space-12);
      align-items: start;
    }

    /* `align-self: start` (via the grid's `align-items`) plus `position:
       sticky` is what keeps the TOC in view while the long body scrolls past
       it; it stops at the end of its own grid area, never overlapping the
       related-work section below. */
    .case-study__toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      max-height: calc(100vh - var(--header-height) - var(--space-12));
      overflow-y: auto;
    }
  }

  /* --- Table of contents --------------------------------------------------- */
  .case-study__toc {
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .case-study__toc-heading {
    margin-bottom: var(--space-3);
  }

  /* Collapsed state, mobile only, and only with JavaScript: without it the
     list below simply stays open, so no section is ever unreachable. */
  .case-study__toc-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .case-study__toc-chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .case-study__toc[data-open] .case-study__toc-chevron {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  .case-study__toc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__toc-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .case-study__toc-link:hover {
    color: var(--color-accent);
    background-color: var(--color-surface-raised);
  }

  /* The section being read. Colour alone never carries the meaning: the
     attribute is what the scroll-spy sets and what a screen reader reads. */
  .case-study__toc-link[aria-current='true'] {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 1023.98px) {
    html.js .case-study__toc-heading {
      display: none;
    }

    html.js .case-study__toc-toggle {
      display: flex;
    }

    html.js .case-study__toc-list {
      display: none;
    }

    html.js .case-study__toc[data-open] .case-study__toc-list {
      display: flex;
      margin-top: var(--space-3);
    }
  }

  /* --- Sections ------------------------------------------------------------ */
