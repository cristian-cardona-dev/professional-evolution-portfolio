---
/**
 * Case-study composition — restructured with Context → Decisions → Impact → Learnings.
 *
 * The case study is organized into four skimmable sections that answer the
 * reader's questions in order: What was the situation? What did you decide?
 * What happened? What did you learn?
 *
 * Each section groups related content from the source markdown:
 *   - Context: Classification + Problem (the situation and constraints)
 *   - Decisions: What was implemented (the design choices)
 *   - Impact: What this demonstrates + What this does not demonstrate (trade-offs)
 *   - Learnings: Evidence + Next boundary (what we learned and where to go next)
 *
 * The progressive disclosure is removed; all four sections are visible by
 * default. This makes the case study skimmable and the trade-offs explicit.
 *
 * Heading order: h1 (project) → h2 (four sections, related, CTA) → h3 (cards).
 */
import type { Copy, Locale } from '../i18n/copy';
import type { Project } from '../lib/data';
import { caseStudyFor, relatedProjects } from '../lib/data';
import { renderSectionBody } from '../lib/markdown';
import { canonicalUrl, route, sectionHref, SUGGESTION_ISSUE_URL } from '../lib/urls';
import ProjectCard from '../components/ProjectCard.astro';
import Comments from '../components/Comments.astro';
import ShareRow from '../components/ShareRow.astro';
import AskAboutPage from '../components/AskAboutPage.astro';
import CopyAnchor from '../components/CopyAnchor.astro';

interface Props {
  locale: Locale;
  copy: Copy;
  project: Project;
}

const { locale, copy, project } = Astro.props;

const study = caseStudyFor(project.slug);

/**
 * The source H1 of the markdown, shown verbatim as provenance
 * (`.case-study__source-title`).
 */
const sourceTitle = study
  ? locale === 'es' && study.title_es
    ? study.title_es
    : study.title
  : null;

/**
 * Section bodies in the page's locale, grouped into the four-part structure.
 */
const sections = study
  ? locale === 'es' && study.sections_es
    ? study.sections_es
    : study.sections
  : [];

/**
 * Group sections into the four-part structure. Each group collects related
 * sections from the source markdown. If a section heading matches (case-insensitive
 * substring), it's included in that group.
 */
function groupSections() {
  const context: typeof sections = [];
  const decisions: typeof sections = [];
  const impact: typeof sections = [];
  const learnings: typeof sections = [];

  for (const section of sections) {
    const heading = section.heading.toLowerCase();
    if (heading.includes('classification') || heading.includes('problem') || heading.includes('clasificación') || heading.includes('problema')) {
      context.push(section);
    } else if (heading.includes('implemented') || heading.includes('implementó')) {
      decisions.push(section);
    } else if (heading.includes('demonstrates') || heading.includes('demuestra')) {
      impact.push(section);
    } else if (heading.includes('evidence') || heading.includes('evidencia') || heading.includes('next') || heading.includes('siguiente')) {
      learnings.push(section);
    }
  }

  return { context, decisions, impact, learnings };
}

const grouped = groupSections();
const hasContent = sections.length > 0;

const related = relatedProjects(project.slug);

/**
 * Spanish pages read the reviewed `summary_es` when the dataset publishes one.
 */
const summary = locale === 'es' && project.summary_es ? project.summary_es : project.summary;

/** Same status→colour mapping the project card uses. */
const statusVariant: Record<Project['status'], string> = {
  live: 'chip--success',
  mvp: 'chip--accent',
  demo: 'chip--accent',
  prototype: 'chip--warn',
  lab: 'chip--neutral',
};

const backHref = route(locale, 'work/');
const contactHref = sectionHref(locale, 'contact', Astro.url.pathname);

/**
 * The canonical URL of this case study, on the Pages origin.
 */
const pageCanonical = canonicalUrl(locale, `work/${project.slug}/`);

/**
 * Seed query of the "ask about this page" deep link.
 */
const askQuery = [project.name, ...project.tags].join(' ');
---

<article class="case-study">
  <header class="case-study__hero">
    <div class="shell shell--narrow">
      <p class="case-study__back reveal">
        <a href={backHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M19 12H5M11 6l-6 6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          {copy.caseStudy.back}
        </a>
      </p>

      <div class="case-study__intro reveal">
        <p class="eyebrow">{copy.caseStudy.eyebrow}</p>
        <h1>{project.name}</h1>

        <div class="case-study__meta">
          <span
            class={`chip ${statusVariant[project.status]}`}
            title={copy.projectStatus.hint[project.status]}
          >
            {copy.projectStatus.label[project.status]}
            <span class="visually-hidden">. {copy.projectStatus.hint[project.status]}</span>
          </span>

          <a class="case-study__repo" href={project.repo} target="_blank" rel="noopener noreferrer">
            {copy.work.repo}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
          </a>
        </div>

        <div class="case-study__share">
          <ShareRow copy={copy} url={pageCanonical?.href} />
          <AskAboutPage copy={copy} query={askQuery} />
        </div>

        {
          sourceTitle && (
            <p class="case-study__source-title">{sourceTitle}</p>
          )
        }

        <p class="lead">{summary}</p>
      </div>
    </div>
  </header>

  <div class="shell shell--narrow case-study__main">
    {
      hasContent ? (
        <div class="case-study__body">
          {/* Context section */}
          {grouped.context.length > 0 && (
            <section class="case-study__section" aria-labelledby="case-study-context">
              <div class="case-study__section-head">
                <h2 id="case-study-context">{copy.caseStudy.contextHeading}</h2>
                <CopyAnchor copy={copy} sectionId="case-study-context" />
              </div>
              <div class="case-study__section-body">
                {grouped.context.map((section, index) => (
                  <div class="case-study__text" set:html={renderSectionBody(section.body)} />
                ))}
              </div>
            </section>
          )}

          {/* Decisions section */}
          {grouped.decisions.length > 0 && (
            <section class="case-study__section" aria-labelledby="case-study-decisions">
              <div class="case-study__section-head">
                <h2 id="case-study-decisions">{copy.caseStudy.decisionsHeading}</h2>
                <CopyAnchor copy={copy} sectionId="case-study-decisions" />
              </div>
              <div class="case-study__section-body">
                {grouped.decisions.map((section, index) => (
                  <div class="case-study__text" set:html={renderSectionBody(section.body)} />
                ))}
              </div>
            </section>
          )}

          {/* Impact section */}
          {grouped.impact.length > 0 && (
            <section class="case-study__section" aria-labelledby="case-study-impact">
              <div class="case-study__section-head">
                <h2 id="case-study-impact">{copy.caseStudy.impactHeading}</h2>
                <CopyAnchor copy={copy} sectionId="case-study-impact" />
              </div>
              <div class="case-study__section-body">
                {grouped.impact.map((section, index) => (
                  <div class="case-study__text" set:html={renderSectionBody(section.body)} />
                ))}
              </div>
            </section>
          )}

          {/* Learnings section */}
          {grouped.learnings.length > 0 && (
            <section class="case-study__section" aria-labelledby="case-study-learnings">
              <div class="case-study__section-head">
                <h2 id="case-study-learnings">{copy.caseStudy.learningsHeading}</h2>
                <CopyAnchor copy={copy} sectionId="case-study-learnings" />
              </div>
              <div class="case-study__section-body">
                {grouped.learnings.map((section, index) => (
                  <div class="case-study__text" set:html={renderSectionBody(section.body)} />
                ))}
              </div>
            </section>
          )}
        </div>
      ) : (
        <div class="state-panel">
          <p>{copy.caseStudy.empty}</p>
          <p>
            <a class="button button--ghost" href={project.repo} target="_blank" rel="noopener noreferrer">
              {copy.work.repo}
              <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
            </a>
          </p>
        </div>
      )
    }
  </div>

  <section class="case-study__related" aria-labelledby="case-study-related-heading">
    <div class="shell">
      <div class="case-study__related-head reveal">
        <p class="eyebrow">{copy.work.eyebrow}</p>
        <h2 id="case-study-related-heading">{copy.work.related}</h2>
      </div>

      {
        related.length > 0 ? (
          <ul class="case-study__related-grid">
            {related.map((item, index) => (
              <li class="case-study__related-item">
                <ProjectCard copy={copy} locale={locale} project={item} revealIndex={index} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="case-study__related-empty">{copy.work.relatedEmpty}</p>
        )
      }
    </div>
  </section>

  <section class="case-study__cta" aria-labelledby="case-study-cta-heading">
    <div class="shell shell--narrow case-study__cta-inner reveal">
      <div class="case-study__cta-text">
        <p class="eyebrow">{copy.contact.eyebrow}</p>
        <h2 id="case-study-cta-heading">{copy.caseStudy.ctaHeading}</h2>
      </div>

      <div class="case-study__cta-actions">
        <a class="button button--primary" href={contactHref}>{copy.caseStudy.ctaContact}</a>
        <a
          class="button button--ghost"
          href={SUGGESTION_ISSUE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.suggestions.cta}
          <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
        </a>
        <p class="case-study__cta-note">{copy.suggestions.note}</p>
      </div>
    </div>
  </section>
</article>

<Comments locale={locale} copy={copy} path={`work/${project.slug}/`} />

<style>
  .case-study {
    display: block;
  }

  /* --- Hero-lite ------------------------------------------------------------ */
  .case-study__hero {
    padding-block: var(--space-8) var(--space-12);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .case-study__back {
    margin-bottom: var(--space-6);
  }

  .case-study__back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .case-study__back a:hover {
    color: var(--color-accent);
  }

  .case-study__back svg {
    width: 16px;
    height: 16px;
  }

  .case-study__intro h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .case-study__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-4);
  }

  .case-study__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .case-study__repo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .case-study__repo svg {
    width: 13px;
    height: 13px;
  }

  .case-study__source-title {
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  /* --- Body ---------------------------------------------------------------- */
  .case-study__main {
    padding-block: var(--space-12) var(--space-8);
  }

  .case-study__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* --- Sections ------------------------------------------------------------ */
  .case-study__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .case-study__section-head h2 {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: 600;
  }

  .case-study__section-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .case-study__text :global(ul) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
  }

  .case-study__text :global(li) {
    max-width: var(--measure);
  }

  .case-study__text :global(li::marker) {
    color: var(--color-accent);
  }

  /* --- Empty state ---------------------------------------------------------- */
  .case-study__main > .state-panel {
    grid-column: 1 / -1;
  }

  /* --- Related work --------------------------------------------------------- */
  .case-study__related {
    padding-block: var(--space-12);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .case-study__related-head {
    margin-bottom: var(--space-6);
  }

  .case-study__related-head h2 {
    margin-top: var(--space-2);
  }

  .case-study__related-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__related-item {
    display: flex;
  }

  .case-study__related-item :global(.project-card__figure),
  .case-study__related-item :global(.project-card__related) {
    display: none;
  }

  .case-study__related-empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .case-study__related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --- Contextual CTA -------------------------------------------------------- */
  .case-study__cta {
    padding-block: var(--space-16) var(--space-24);
  }

  .case-study__cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .case-study__cta-text h2 {
    margin-top: var(--space-2);
  }

  .case-study__cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .case-study__cta-note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }
</style>
