---
/**
 * Public GitHub activity feed — a compact, build-time snapshot.
 *
 * Reads `github-activity/snapshot.json` through a static import, so the site
 * ships the data with the HTML and the browser never calls GitHub. One entry is
 * rendered per allowlisted repository: its name and link, the latest commit
 * message and date, the open pull-request count, and the latest release tag when
 * one exists.
 *
 * Nothing is invented: when the snapshot carries no records the honest empty
 * state is shown, and a repository without commits says so rather than rendering
 * a fabricated message. The section heading is an `h2` (the page `h1` is the
 * evidence page heading) and each repository is an `h3`, keeping the heading
 * order h1 → h2 → h3.
 */
import type { Copy, Locale } from '../i18n/copy';
import { formatRelativeTime, freshnessBucket, type Freshness } from '../lib/relative-time';
import snapshot from '../../../github-activity/snapshot.json';

/** One commit, pull request or release as the snapshot stores it. */
interface ActivityObject {
  id: string;
  url: string;
  captured_at: string;
  title: string;
  /** Present only for bot-authored commits (dependabot, renovate, actions). */
  bot?: boolean;
}

interface Repository {
  id: string;
  url: string;
  visibility: string;
  commits: ActivityObject[];
  pull_requests: ActivityObject[];
  releases: ActivityObject[];
  deployments: ActivityObject[];
  /** Open pull-request count, when the refresh captured one. */
  open_pull_requests?: number;
  /** Marker set by the refresh script when the last fetch failed. */
  error?: string;
  /** The repository no longer exists on GitHub; its data is deliberately empty. */
  unavailable?: boolean;
}

/** The snapshot's own freshness contract (mirrors github-activity/validate.mjs). */
interface SnapshotStatus {
  availability: 'available' | 'empty' | 'partial' | 'unavailable';
  stale: boolean;
  message: string;
  failed_repos?: string[];
}

interface SnapshotDoc {
  captured_at: string;
  status: SnapshotStatus;
}

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

/** JSON imports widen literals; the shape is enforced by the validator. */
const doc = snapshot as unknown as SnapshotDoc;
const repositories = (snapshot.repositories ?? []) as unknown as Repository[];

const dateFormat = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

function formatDate(value: string): string {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : dateFormat.format(date);
}

/** Shared relative-time helpers (also used by /build/ and the footer). */
const formatRelative = (value: string): string => formatRelativeTime(value, locale);

/** `owner/repo` → `repo`; the owner is the same across the allowlist. */
function repoName(id: string): string {
  const parts = id.split('/');
  return parts[parts.length - 1] || id;
}

// --- Freshness -------------------------------------------------------------
const capturedAt = doc.captured_at;
const freshness: Freshness = freshnessBucket(capturedAt);

const freshnessLabel =
  freshness === 'fresh'
    ? copy.activity.freshnessFresh
    : freshness === 'aging'
      ? copy.activity.freshnessAging
      : copy.activity.freshnessStale;

const status = doc.status;
const failedCount = status?.failed_repos?.length ?? 0;
/**
 * `empty` is an honest "no activity" state, not a freshness defect, so it does
 * not raise the stale badge — it already has its own messaging below.
 */
const showStaleBadge =
  Boolean(status?.stale) || status?.availability === 'partial' || status?.availability === 'unavailable';
const staleBadgeText = status?.stale
  ? copy.activity.staleNote
  : failedCount > 0
    ? copy.activity.partialNote(failedCount)
    : copy.activity.staleNote;

// --- Headline commit (bot-aware) -------------------------------------------
function headlineCommit(repo: Repository): { commit?: ActivityObject; botsFiltered: number } {
  const commits = repo.commits ?? [];
  const firstHuman = commits.find((c) => !c.bot);
  const botsFiltered = commits.filter((c) => c.bot).length;
  return { commit: firstHuman ?? (botsFiltered > 0 ? undefined : commits[0]), botsFiltered };
}

// --- Honest empty state link -----------------------------------------------
const allowed = ((snapshot as unknown as { allowed_repositories?: string[] })
  .allowed_repositories ?? []) as string[];
const allowedFirst = allowed[0];

/** `https://github.com/owner/repo` → `owner/repo`. */
function slugOf(url: string): string {
  return url.replace(/\/+$/, '').replace(/^https:\/\/github\.com\//, '');
}
---

<section class="section activity" id="github-activity" aria-labelledby="activity-heading">
  <div class="shell">
    <header class="section__head reveal">
      <h2 id="activity-heading">{copy.activity.heading}</h2>
      <p class="activity__note">{copy.activity.note}</p>

      {/* Freshness stamp: relative time, bucket label and absolute date.
          aria-live announces updates without stealing focus; the glyph is
          decorative because the bucket word carries the same meaning. */}
      <p class={`activity__stamp activity__stamp--${freshness}`} aria-live="polite">
        <span class="activity__stamp-glyph" aria-hidden="true">
          {freshness === 'fresh' ? '●' : freshness === 'aging' ? '▲' : '■'}
        </span>
        <span>{copy.activity.lastUpdated(formatRelative(capturedAt))}</span>
        <span class="activity__stamp-bucket">({freshnessLabel})</span>
        <time class="activity__stamp-absolute tabular" datetime={capturedAt}>
          {copy.activity.lastUpdatedOn(formatDate(capturedAt))}
        </time>
      </p>

      {showStaleBadge && (
        <p class="activity__stale" role="status">
          <span class="activity__stale-glyph" aria-hidden="true">■</span>
          {staleBadgeText}
        </p>
      )}
    </header>

    {
      repositories.length === 0 ? (
        <div class="state-panel activity__empty">
          <p>{copy.activity.empty}</p>
          {allowedFirst && (
            <p>
              <a href={allowedFirst} target="_blank" rel="noopener noreferrer">
                {repoName(slugOf(allowedFirst))}
                <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
              </a>
            </p>
          )}
        </div>
      ) : (
        <ul class="activity__repos">
          {repositories.map((repo) => {
            const { commit: latestCommit, botsFiltered } = headlineCommit(repo);
            const release = repo.releases?.[0];
            const openPullRequests = repo.open_pull_requests ?? repo.pull_requests?.length ?? 0;
            return (
              <li class="activity__repo reveal">
                <h3 class="activity__repo-name">
                  <a href={repo.url} target="_blank" rel="noopener noreferrer">
                    {repoName(repo.id)}
                    <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
                  </a>
                </h3>

                {repo.unavailable ? (
                  <p class="activity__muted" role="status">{copy.activity.unavailable}</p>
                ) : (
                  <>
                    {repo.error && (
                      <p class="activity__error" role="status">
                        <span class="activity__error-glyph" aria-hidden="true">▲</span>
                        {copy.activity.refreshFailed}
                      </p>
                    )}

                    {latestCommit ? (
                      <p class="activity__commit">
                        <a
                          class="activity__commit-link"
                          href={latestCommit.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {latestCommit.title}
                          <span class="visually-hidden"> ({copy.a11y.opensInNewTab})</span>
                        </a>
                        <time
                          class="activity__date tabular"
                          datetime={latestCommit.captured_at}
                          title={formatDate(latestCommit.captured_at)}
                        >
                          {formatRelative(latestCommit.captured_at)}
                        </time>
                        {botsFiltered > 0 && (
                          <span class="activity__bot-note">{copy.activity.botNote(botsFiltered)}</span>
                        )}
                      </p>
                    ) : (
                      <p class="activity__muted">{copy.activity.noCommits}</p>
                    )}

                    <p class="activity__meta">
                      <span class="chip chip--neutral">
                        {copy.activity.openPullRequests(openPullRequests)}
                      </span>
                      {release && (
                        <span class="chip chip--accent">{copy.activity.latestRelease(release.title)}</span>
                      )}
                    </p>
                  </>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .section__head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  .section__head h2 {
    margin-block: var(--space-2) var(--space-3);
  }

  .activity__note {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .activity__empty {
    max-width: 68ch;
  }

  .activity__repos {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity__repo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .activity__repo-name {
    font-size: var(--text-md);
    line-height: var(--leading-md);
  }

  .activity__repo-name a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .activity__commit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .activity__commit-link {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .activity__date {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  .activity__muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .activity__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Freshness stamp ------------------------------------------------------ */
  .activity__stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
  }

  .activity__stamp-glyph {
    font-size: 0.7em;
    line-height: 1;
  }

  /* Colour only the decorative glyph, never the text: on the light theme none
     of the three status colours reaches AA as body text (warn is ~3.2:1 on
     #f2efe6), and the bold bucket word already carries the meaning. This
     matches how /build/ and the footer render the same stamp. */
  .activity__stamp--fresh .activity__stamp-glyph {
    color: var(--color-success);
  }

  .activity__stamp--aging .activity__stamp-glyph {
    color: var(--color-warn);
  }

  .activity__stamp--stale .activity__stamp-glyph {
    color: var(--color-danger);
  }

  .activity__stamp-bucket {
    font-weight: 600;
  }

  .activity__stamp-absolute {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Stale / partial badge ------------------------------------------------ */
  .activity__stale {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-warn);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .activity__stale-glyph {
    color: var(--color-warn);
    font-size: 0.7em;
    line-height: 1;
  }

  /* Per-repo refresh failure --------------------------------------------- */
  .activity__error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .activity__error-glyph {
    color: var(--color-danger);
    font-size: 0.7em;
    line-height: 1;
  }

  .activity__bot-note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  .activity__empty a {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .activity__stamp-glyph,
    .activity__stale-glyph,
    .activity__error-glyph {
      transition: opacity var(--duration-fast, 150ms) ease;
    }
  }
</style>
