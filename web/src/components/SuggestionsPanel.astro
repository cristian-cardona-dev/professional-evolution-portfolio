---
/**
 * Suggestions panel — feedback stays public.
 *
 * A suggestion is filed as an issue in the source repository, so the request
 * and the answer remain inspectable by anyone reading the project. The link
 * opens in a new tab and is announced as such.
 */
import type { Copy } from '../i18n/copy';
import { SUGGESTION_ISSUE_URL } from '../lib/urls';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="suggestions" aria-labelledby="suggestions-heading">
  <div class="shell suggestions__inner reveal">
    <div class="suggestions__text">
      <h2 class="suggestions__heading" id="suggestions-heading">{copy.suggestions.heading}</h2>
      <p class="suggestions__summary">{copy.suggestions.summary}</p>
    </div>

    <div class="suggestions__action">
      <a class="button button--ghost" href={SUGGESTION_ISSUE_URL} target="_blank" rel="noopener noreferrer">
        {copy.suggestions.cta}
        <svg class="suggestions__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
      </a>
      <p class="suggestions__note">{copy.suggestions.note}</p>
    </div>
  </div>
</section>

<style>
  .suggestions {
    padding-block: var(--space-24);
  }

  .suggestions__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .suggestions__heading {
    margin-block: var(--space-2) var(--space-3);
  }

  .suggestions__summary {
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .suggestions__action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .suggestions__icon {
    width: 14px;
    height: 14px;
  }

  .suggestions__note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }
</style>