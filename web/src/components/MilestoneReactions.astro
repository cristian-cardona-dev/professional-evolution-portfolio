---
/**
 * Milestone reactions — one anonymous ❤️ per milestone detail page.
 *
 * Identity is the CANONICAL milestone id (`data/evolution.json`), never the
 * locale-prefixed page id, so the EN and ES routes of one milestone call the
 * same endpoint and share one counter. The endpoint is
 * `/api/milestones/{milestoneId}/reaction` (GET / PUT / DELETE) and lives on the
 * comments Worker (`config/comments.json` → `apiBase`), reusing its CORS
 * allowlist and its IP-only abuse guard.
 *
 * Privacy contract: the client generates an opaque nonce and keeps it in
 * `localStorage` purely as a convenience; the server hashes it with a per-room
 * secret before storing it and never returns it, the IP or the hash. There are
 * no accounts and no fingerprinting.
 *
 * Honest degradation:
 *   1. the initial state is `loading`: the button is rendered but disabled and
 *      `aria-busy`, and the status region says so — it never claims a count;
 *   2. if the API cannot be reached the control moves to `unavailable`, stays
 *      disabled and says why;
 *   3. without JavaScript the button stays disabled (never a pretend control)
 *      and a `<noscript>` note explains that nothing is sent.
 * The control is deliberately NOT hidden behind the `html.js` gate: it has to
 * remain in the accessibility tree so the a11y gate audits it. Only the dynamic
 * count area is pinned for full-page captures (`tests/visual/screenshot.css`).
 */
import type { Copy, Locale } from '../i18n/copy';
import { commentsApiBase } from '../lib/comments';

interface Props {
  locale: Locale;
  copy: Copy;
  /** Canonical milestone id from `data/evolution.json` (never locale-prefixed). */
  milestoneId: string;
}

const { locale, copy, milestoneId } = Astro.props;
const apiBase = commentsApiBase();
const endpoint = `${apiBase}/api/milestones/${encodeURIComponent(milestoneId)}/reaction`;
---

<section
  class="milestone-reactions"
  data-reactions
  data-endpoint={endpoint}
  data-milestone={milestoneId}
  data-locale={locale}
  data-state="loading"
  data-count-one={copy.reactions.countOne}
  data-count-many={copy.reactions.countMany}
  data-loading={copy.reactions.loading}
  data-added={copy.reactions.added}
  data-removed={copy.reactions.removed}
  data-error={copy.reactions.error}
  data-rate-limited={copy.reactions.rateLimited}
  data-unavailable={copy.reactions.unavailable}
>
  <div class="milestone-reactions__control" role="group" aria-label={copy.reactions.group}>
    <button
      class="milestone-reactions__button"
      type="button"
      data-reactions-button
      aria-pressed="false"
      aria-busy="true"
      disabled
    >
      <svg class="milestone-reactions__heart" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
      <span class="milestone-reactions__label" data-reactions-label>{copy.reactions.useful}</span>
      <span class="milestone-reactions__count tabular" data-reactions-count>—</span>
    </button>
    <p class="milestone-reactions__status" role="status" aria-live="polite" data-reactions-status>
      {copy.reactions.loading}
    </p>
  </div>
  <p class="milestone-reactions__note">{copy.reactions.note}</p>
  <noscript>
    <p class="milestone-reactions__nojs">{copy.reactions.noJs}</p>
  </noscript>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-reactions]');
    if (!root) return;

    const button = root.querySelector('[data-reactions-button]');
    const countEl = root.querySelector('[data-reactions-count]');
    const statusEl = root.querySelector('[data-reactions-status]');
    if (!button || !countEl || !statusEl) return;

    const endpoint = root.dataset.endpoint || '';
    const countOne = root.dataset.countOne || '';
    const countMany = root.dataset.countMany || '';
    const loadingText = root.dataset.loading || '';
    const addedText = root.dataset.added || '';
    const removedText = root.dataset.removed || '';
    const errorText = root.dataset.error || '';
    const rateLimitedText = root.dataset.rateLimited || '';
    const unavailableText = root.dataset.unavailable || '';

    // The nonce is a convenience only: the server's hashed idempotency is
    // authoritative, and a cleared localStorage simply looks like a new visitor.
    const NONCE_KEY = 'pep:reaction-nonce';
    const NONCE_PATTERN = /^[A-Za-z0-9_-]{16,128}$/;
    let memoryNonce = '';

    const freshNonce = () => {
      try {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') {
          return window.crypto.randomUUID().replace(/-/g, '');
        }
      } catch {
        /* fall through to getRandomValues */
      }
      try {
        const bytes = new Uint8Array(16);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
      } catch {
        return `n${Date.now().toString(36)}${Math.random().toString(36).slice(2, 12)}`;
      }
    };

    const nonce = (() => {
      try {
        const stored = window.localStorage.getItem(NONCE_KEY);
        if (stored && NONCE_PATTERN.test(stored)) return stored;
        const created = freshNonce();
        window.localStorage.setItem(NONCE_KEY, created);
        return created;
      } catch {
        // Storage can be unavailable (private mode, storage disabled): keep an
        // in-memory nonce so the control still works for this page view.
        if (!memoryNonce) memoryNonce = freshNonce();
        return memoryNonce;
      }
    })();

    const setStatus = (message) => {
      statusEl.textContent = message || '';
    };

    const countText = (value) => {
      const n = Number.isFinite(value) ? value : 0;
      return n === 1 ? countOne : countMany.replace('{n}', String(n));
    };

    const applyState = (state) => {
      const reacted = state && state.reacted === true;
      const count = state && Number.isFinite(state.count) ? state.count : 0;
      countEl.textContent = String(count);
      button.setAttribute('aria-pressed', reacted ? 'true' : 'false');
      button.removeAttribute('aria-busy');
      button.disabled = false;
      root.dataset.state = 'ready';
      return reacted;
    };

    const applyUnavailable = () => {
      root.dataset.state = 'unavailable';
      countEl.textContent = '—';
      button.removeAttribute('aria-busy');
      button.disabled = true;
      setStatus(unavailableText);
    };

    const headers = { accept: 'application/json', 'x-reaction-nonce': nonce };

    const load = async () => {
      try {
        const response = await fetch(endpoint, { headers });
        if (!response.ok) throw new Error('reaction state failed');
        const data = await response.json();
        applyState(data);
        setStatus('');
      } catch {
        applyUnavailable();
      }
    };

    const toggle = async () => {
      const pressed = button.getAttribute('aria-pressed') === 'true';
      const method = pressed ? 'DELETE' : 'PUT';
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      setStatus(loadingText);
      try {
        const response = await fetch(endpoint, { method, headers });
        if (response.status === 429) {
          button.removeAttribute('aria-busy');
          button.disabled = false;
          setStatus(rateLimitedText);
          return;
        }
        if (!response.ok) throw new Error('reaction failed');
        const data = await response.json();
        const reacted = applyState(data);
        setStatus(`${reacted ? addedText : removedText} ${countText(data.count)}`.trim());
      } catch {
        // The server state is unchanged, so the pressed state stays as it was.
        button.removeAttribute('aria-busy');
        button.disabled = false;
        setStatus(errorText);
      }
    };

    button.addEventListener('click', toggle);
    load();
  })();
</script>

<style>
  .milestone-reactions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .milestone-reactions__control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .milestone-reactions__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .milestone-reactions__button:hover:not(:disabled) {
    border-color: var(--color-accent);
  }

  .milestone-reactions__button:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: var(--ring-focus);
  }

  /* No opacity on the disabled state: axe still audits the initial (loading)
     control, and a reduced-opacity label can fail contrast. */
  .milestone-reactions__button:disabled {
    cursor: default;
    color: var(--color-text-muted);
  }

  .milestone-reactions__button[aria-pressed='true'] {
    border-color: var(--color-accent);
    background-color: var(--color-surface-raised);
    color: var(--color-accent);
  }

  .milestone-reactions__heart {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .milestone-reactions__count {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .milestone-reactions__button[aria-pressed='true'] .milestone-reactions__count {
    color: inherit;
  }

  .milestone-reactions__status,
  .milestone-reactions__note,
  .milestone-reactions__nojs {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .milestone-reactions__status:empty {
    display: none;
  }
</style>
