---
/**
 * Site header — sticky, one nav, no JS framework.
 *
 * The mobile menu is a disclosure button: `<button type="button">` carries
 * `aria-expanded` and `aria-controls`, and a tiny inline script flips both the
 * attribute and the `data-open` marker on the header; CSS does the rest. The
 * button is the native disclosure control, so Space and Enter both work with
 * no key handling of our own, and assistive tech announces open/closed from
 * `aria-expanded` rather than from colour.
 *
 * Without JavaScript the panel is simply always visible below 1024px (the
 * `.js` gate on <html> is what enables the collapsed state), so a no-JS visit
 * never loses the navigation to a button that cannot work — the same
 * progressive-enhancement contract the work-page filter uses.
 *
 * From 1024px up the button is removed from the layout and the panel is always
 * visible. At tablet widths it remains a disclosure so the nav and controls fit
 * without horizontal overflow; exactly one nav landmark exists at every width.
 *
 * On the home page a tiny scroll-spy marks the nav link of the section in view
 * with `aria-current="true"`; every other route keeps the static
 * `aria-current="page"` the `active` prop sets, or — for the career route,
 * which has no `activeNav` marker — the one the pathname check below derives.
 */
import type { Copy, Locale } from '../i18n/copy';
import { profile } from '../lib/data';
import { localeRoot, route, sectionHref } from '../lib/urls';
import CommandPalette from './CommandPalette.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  copy: Copy;
  locale: Locale;
  /** Currently visible home section, used for the active nav indicator. */
  active?: 'projects' | 'evolution' | 'evidence' | 'contact';
  /** Locale-relative path, used by the language switch to link to the same page in the other locale. */
  path?: string;
}

const { copy, locale, active, path } = Astro.props;
const pathname = Astro.url.pathname;
const root = localeRoot(locale);

/** Nav ids. `career` is a route like the others, and it also names a home
    section, so it joins the scroll-spy list. */
type NavId = NonNullable<Props['active']> | 'career';

/* Work, Career, Evolution and Evidence are routes and stay absolute from every
   page; Contact is a home section, so it is a plain fragment on the home page
   itself and points at the same-language home section everywhere else.
   Section ids keep the preserved anchors: #projects, #career, #contact. */
/* Seam: `/guestbook/` is published but deliberately absent from this list -
   it is a destination, not a section, and it keeps its discoverability slot
   for later. Adding it means one entry here plus widening `NavId`, the
   `active` prop above and `BaseLayout`'s `activeNav` union to carry its id. */
const links: { id: NavId; href: string; label: string }[] = [
  { id: 'projects', href: route(locale, 'work/'), label: copy.nav.work },
  { id: 'career', href: route(locale, 'career/'), label: copy.nav.career },
  { id: 'evolution', href: route(locale, 'evolution/'), label: copy.nav.evolution },
  { id: 'evidence', href: route(locale, 'evidence/'), label: copy.nav.evidence },
  { id: 'contact', href: sectionHref(locale, 'contact', pathname), label: copy.nav.contact },
];

/* The career route resolves its own `aria-current` from the pathname, the same
   signal `sectionHref` already uses: `BaseLayout`'s `activeNav` union is
   unchanged by this task, so there is no prop to pass. Every other link keeps
   the behaviour the `active` prop drives. */
const isCurrent = (id: NavId): boolean =>
  active === id || (id === 'career' && pathname === route(locale, 'career/'));
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href={root}>
      <span class="site-header__mark" aria-hidden="true"></span>
      <span class="site-header__name">{profile.name}</span>
    </a>

    <button
      type="button"
      class="site-nav__button"
      aria-expanded="false"
      aria-controls="site-nav-panel"
      data-site-nav-toggle
    >
      <span class="site-nav__bars" aria-hidden="true"></span>
      <span class="site-nav__button-label">{copy.nav.menuLabel}</span>
    </button>

    <div class="site-header__panel" id="site-nav-panel">
      <nav class="site-nav" aria-label={copy.a11y.primaryNav}>
        <ul class="site-nav__list">
          {
            links.map((link) => (
              <li>
                <a
                  class="site-nav__link"
                  href={link.href}
                  data-nav-section={link.id}
                  aria-current={isCurrent(link.id) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__controls">
        <button
          type="button"
          class="site-header__palette"
          data-palette-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="pep-palette-dialog"
        >
          <span class="visually-hidden">{copy.palette.open}</span>
          <kbd class="site-header__palette-keys">⌘K</kbd>
        </button>
        <LangSwitch copy={copy} locale={locale} path={path} />
        <ThemeToggle copy={copy} />
      </div>
    </div>
  </div>
</header>

<CommandPalette copy={copy} locale={locale} />

<script>
  // Disclosure state for the mobile menu: `aria-expanded` on the button and a
  // `data-open` marker on the header (which the scoped CSS keys off). No
  // focus management is needed — the panel contains no focus trap and the
  // links stay in DOM order right after the button.
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('[data-site-nav-toggle]');
  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      if (open) header.setAttribute('data-open', '');
      else header.removeAttribute('data-open');
    });
  }

  // Scroll-spy (home only): keep `aria-current` on the nav link of the home
  // section currently in view. It only runs when those sections exist, so
  // every other page keeps the static `aria-current` set by the `active` prop
  // (or, for the career route, by the pathname check above) and a no-JS visit
  // is unchanged. The ids are in document order, so the first visible one wins
  // when two sections overlap at a section boundary. Nothing animates, so
  // reduced motion is irrelevant. A link that is not current has only our own
  // `true` value cleared; the route-level `page` value is never touched.
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-section]'));
  const sections = ['projects', 'career', 'evolution', 'evidence', 'contact']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  if (navLinks.length > 0 && sections.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const current = sections.find((section) => visible.has(section.id));
        for (const link of navLinks) {
          const isCurrent = current !== undefined && link.dataset.navSection === current.id;
          if (isCurrent) link.setAttribute('aria-current', 'true');
          else if (link.getAttribute('aria-current') === 'true') link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
    flex-wrap: wrap;
    padding-block: var(--space-2);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .site-header__mark {
    width: 10px;
    height: 10px;
    flex: none;
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  /* --- Disclosure control --------------------------------------------------
   * Hidden by default: without JavaScript the button could not work, so the
   * panel below simply stays open (see the panel rules). `html.js` on the
   * document element — set pre-paint by BaseLayout — is what enables the
   * collapsed mobile menu. */
  .site-nav__button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
    user-select: none;
  }

  .site-nav__button:hover,
  .site-nav__button[aria-expanded='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-nav__bars,
  .site-nav__bars::before,
  .site-nav__bars::after {
    display: block;
    width: 16px;
    height: 2px;
    background-color: currentColor;
    content: '';
  }

  .site-nav__bars {
    position: relative;
  }

  .site-nav__bars::before,
  .site-nav__bars::after {
    position: absolute;
    left: 0;
  }

  .site-nav__bars::before {
    top: -5px;
  }

  .site-nav__bars::after {
    top: 5px;
  }

  /* --- Panel ---------------------------------------------------------------
   * Default (no JS): visible at every width — the navigation must survive a
   * page whose script never ran. `html.js` enables the collapsed mobile state;
   * `data-open` is what the button toggles. */
  .site-header__panel {
    display: flex;
    flex-basis: 100%;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  @media (max-width: 1023.98px) {
    html.js .site-nav__button {
      display: inline-flex;
    }

    html.js .site-header__panel {
      display: none;
    }

    html.js .site-header[data-open] .site-header__panel {
      display: flex;
    }
  }

  .site-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .site-nav__link:hover {
    color: var(--color-accent);
    background-color: var(--color-surface-raised);
  }

  .site-nav__link[aria-current='page'],
  .site-nav__link[aria-current='true'] {
    color: var(--color-accent);
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  /* --- Command palette trigger --------------------------------------------
   * Hidden without JavaScript (the `html.js` gate) because the palette cannot
   * open without a script, and hidden below 1024px where a keyboard shortcut
   * hint adds little on touch devices. */
  .site-header__palette {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background-color: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .site-header__palette:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-surface-raised);
  }

  .site-header__palette-keys {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    letter-spacing: 0.04em;
  }

  @media (min-width: 1024px) {
    html.js .site-header__palette {
      display: inline-flex;
    }
  }

  /* --- Wide viewport: one always-visible nav, no disclosure control -------- */
  @media (min-width: 1024px) {
    .site-nav__button {
      display: none;
    }

    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-header__panel {
      flex-basis: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding-block: 0;
    }

    .site-nav__list {
      flex-direction: row;
      align-items: center;
      gap: var(--space-1);
    }

    .site-header__controls {
      padding-top: 0;
      padding-left: var(--space-4);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }
</style>
