---
/**
 * Hero — who, what, and how to check it, in the first viewport.
 *
 * The name is the single `h1` of the page; the headline from `profile.json`
 * is the role line, so the page keeps exactly one top-level heading.
 */
import type { Copy, Locale } from '../i18n/copy';
import { profile } from '../lib/data';
import { sectionHref } from '../lib/urls';

interface Props {
  copy: Copy;
  /** Home locale; every CTA targets a section of this language's home. */
  locale?: Locale;
}

const { copy, locale = 'en' } = Astro.props;
const pathname = Astro.url.pathname;

const socials = [
  { href: profile.socials.github, label: copy.hero.github },
  { href: profile.socials.linkedin, label: copy.hero.linkedin },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="shell hero__inner">
    <p class="eyebrow reveal" style="--reveal-index: 0">{copy.hero.eyebrow}</p>

    <h1 class="hero__name reveal" id="hero-heading" style="--reveal-index: 1">{profile.name}</h1>

    <p class="hero__headline reveal" style="--reveal-index: 2">{profile.headline}</p>

    <p class="lead hero__one-liner reveal" style="--reveal-index: 3">{copy.hero.oneLiner}</p>

    <p class="hero__principle reveal" style="--reveal-index: 4">{copy.hero.principle}</p>

    <div class="hero__actions reveal" style="--reveal-index: 5">
      <a class="button button--primary" href={sectionHref(locale, 'projects', pathname)}>
        {copy.hero.ctaWork}
      </a>
      <a class="button button--ghost" href={sectionHref(locale, 'evidence', pathname)}>
        {copy.hero.ctaEvidence}
      </a>
    </div>

    <ul class="hero__socials reveal" style="--reveal-index: 6">
      {
        socials.map((social) => (
          <li>
            <a class="hero__social" href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label}
              <svg
                class="hero__social-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-24);
    /* A single restrained accent glow keeps the dark-first depth without
       decoration competing with the content. */
    background-image: radial-gradient(
      60% 55% at 50% 0%,
      color-mix(in srgb, var(--color-accent) 12%, transparent) 0%,
      transparent 70%
    );
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .hero__name {
    margin-top: var(--space-2);
  }

  .hero__headline {
    max-width: 34ch;
    color: var(--color-accent);
    font-size: clamp(var(--text-md), 5vw, var(--text-lg));
    line-height: var(--leading-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .hero__one-liner {
    max-width: 52ch;
  }

  .hero__principle {
    max-width: 58ch;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .hero__social:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-surface-raised);
  }

  .hero__social-icon {
    width: 14px;
    height: 14px;
    flex: none;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-32);
    }
  }
</style>