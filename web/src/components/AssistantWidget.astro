---
/**
 * Portfolio assistant — honest search with two modes (v1 keyword, F-C semantic).
 *
 * A floating button opens an accessible dialog (role=dialog, aria-modal, Esc
 * and click-outside close, focus moves in on open and back to the trigger on
 * close) and searches a compact index that is serialized into the page at
 * build time from the canonical `data/*.json` — no API key, no backend and no
 * simulated intelligence: there is no typing animation, no canned prose and no
 * model call anywhere in this component. The honesty banner at the top of the
 * panel says what this is in plain words, a mode line states which search this
 * build actually ships, and an unmatched query renders the honest fallback
 * (links to the full work and evidence listings plus a prefilled `mailto:`
 * carrying the question) instead of an invented answer.
 *
 * Two modes, both honest (spec section 10):
 *
 *   - **keyword-only** — the v1 behaviour: `searchEntries` over the embedded
 *     index. This is what CI builds, because it has no Cloudflare token.
 *   - **semantic** — the build embedded the corpus with `@cf/baai/bge-m3` and
 *     shipped `semantic-index.json`; the client fetches that one static,
 *     same-origin file and ranks with `hybridSearch` (`lib/semantic-search.ts`),
 *     falling back to the keyword search when it is absent or scores low.
 *     There is still **no AI call at query time** — the model ran at build time
 *     only. Which mode is live is read from `build-metadata.json`
 *     (`lib/build-metadata.ts`) and stated in the panel and on `/build/`.
 *
 * The index is built by `assistantIndex` in `lib/data.ts` (delegating to
 * `lib/assistant-corpus.ts`); all matching and ranking lives in
 * `lib/assistant-search.ts` and `lib/semantic-search.ts`, pure enough to run in
 * a browser, in the Astro build and in a plain `node` verification script.
 * Result rows are rendered server-side (in the page locale, with localized
 * status chips mirroring `EvidenceBadge`/`ProjectCard`); the client script only
 * scores queries and moves pre-rendered rows into the results list, so no copy
 * ever has to be shipped to the browser as strings.
 *
 * Suggested-question chips display the visitor's language but carry fixed
 * English keyword queries, because the published data they search is
 * English-only; a Spanish question would otherwise answer nothing. The
 * limitation is stated in `docs/assistant.md`.
 *
 * A page can also open the panel with a seeded query through the documented
 * `assistant:ask` CustomEvent (dispatched by
 * `components/AskAboutPage.astro`); the event only fills the input and calls
 * the same `run` the form and the chips use, so it adds a door into this
 * widget and no behaviour of its own.
 *
 * Without JavaScript the button itself is hidden (the `html.js` gate), so a
 * no-JS visit loses nothing: every piece of content the assistant indexes is
 * already a published page.
 */
import type { Copy, Locale } from '../i18n/copy';
import { assistantIndex, profile } from '../lib/data';
import { readBuildMetadata } from '../lib/build-metadata';
import { route } from '../lib/urls';

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

/** Which search this build ships; stated in the panel, never implied. */
const buildMetadata = readBuildMetadata();
const modeNote =
  buildMetadata.semantic_index === 'semantic'
    ? copy.assistant.modeSemantic
    : copy.assistant.modeKeyword;

/** The widget is useful only with an index; the canonical data is always
 *  non-empty, but the guard keeps the promise explicit. */
const entries = assistantIndex(copy, locale);

/** Chip display labels come from the locale (`copy.assistant.chips`); the
 *  queries are the stable English keyword sets the canonical data contains. */
const chips = [
  { query: 'built projects', label: copy.assistant.chips.built },
  // `ai` alone is the honest answer to "What AI work is demonstrated?":
  // the labs rank first because their names carry the token. Adding
  // "demonstrated" would promote status-word matches over the AI work
  // itself, which is not what the question asks.
  { query: 'ai', label: copy.assistant.chips.ai },
  { query: 'contact', label: copy.assistant.chips.contact },
  { query: 'aspirational demonstrated', label: copy.assistant.chips.contrast },
];

/** Fallback compose: subject prefill is localized copy, body is filled by the
 *  client script with the visitor's actual question. */
const mailtoBase = `mailto:${profile.email}?subject=${encodeURIComponent(
  copy.assistant.emailSubject,
)}&body=`;

/** `<` is escaped so a `</script>` sequence can never terminate the block. */
const indexJson = JSON.stringify(entries).replace(/</g, '\\u003c');
---

{
  entries.length > 0 && (
    <div class="assistant" data-assistant>
      <button
        type="button"
        class="assistant__fab"
        data-a-fab
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="pep-assistant-panel"
        aria-label={copy.assistant.open}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
          <path
            d="m16.5 16.5 4.5 4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <div
        class="assistant__panel"
        id="pep-assistant-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="pep-assistant-title"
        data-a-panel
        tabindex="-1"
        hidden
      >
        <div class="assistant__head">
          <h2 class="assistant__title" id="pep-assistant-title">{copy.assistant.title}</h2>
          <button
            type="button"
            class="assistant__close"
            data-a-close
            aria-label={copy.assistant.close}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M6 6l12 12M18 6 6 18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <p class="assistant__banner" id="pep-assistant-banner">{copy.assistant.banner}</p>

        {/* Which search this build actually ships, read from the generated
            build metadata. Keyword-only is the CI build (no Cloudflare token);
            semantic means the build embedded the corpus at build time. Either
            way there is no AI call at query time. */}
        <p class="assistant__mode" data-a-mode>{modeNote}</p>

        {/* WebMCP annotation (agent-facing, English on both locales, like the
            contact form). It describes what this form really does — a search of
            the index already embedded in this page, plus (when the build
            shipped vectors) one same-origin static JSON file — so an agent is
            not sold a capability the site does not have: no backend, no model
            call at query time, and an honest empty result. */}
        <form
          class="assistant__form"
          data-a-form
          toolname="site_search"
          tooldescription="Searches this site's own published index and returns links to the pages that match. It runs entirely in the visitor's browser against an index embedded in the page and, when the build shipped semantic vectors, a same-origin static JSON file: no backend and no AI model or API call at query time. A query that matches nothing returns an honest fallback with the site's own listings instead of an invented answer."
        >
          <label class="visually-hidden" for="pep-assistant-input">{copy.assistant.open}</label>
          <input
            class="assistant__input"
            id="pep-assistant-input"
            data-a-input
            type="search"
            name="q"
            autocomplete="off"
            placeholder={copy.assistant.placeholder}
            aria-describedby="pep-assistant-banner"
            toolparamdescription="Keywords matched against the titles, summaries and status text of the site's own published pages."
          />
          <button class="button button--primary assistant__submit" type="submit">
            {copy.assistant.submit}
          </button>
        </form>

        <p class="assistant__chips-heading">{copy.assistant.suggestedHeading}</p>
        <ul class="assistant__chips">
          {chips.map((chip) => (
            <li>
              <button type="button" class="assistant__chip" data-a-chip data-query={chip.query}>
                {chip.label}
              </button>
            </li>
          ))}
        </ul>

        <div class="assistant__out" data-a-out aria-live="polite" hidden>
          <p class="assistant__error" data-a-error hidden role="alert"></p>
          <p class="assistant__out-label" data-a-label hidden>{copy.assistant.results}</p>
          <ol class="assistant__results" data-a-results hidden></ol>
          <div class="assistant__fallback" data-a-fallback hidden>
            <p>{copy.assistant.fallback}</p>
            <ul class="assistant__fallback-links">
              <li>
                <a href={route(locale, 'work/')}>{copy.work.viewAll}</a>
              </li>
              <li>
                <a href={route(locale, 'evidence/')}>{copy.evidence.viewAll}</a>
              </li>
              <li>
                <a href={mailtoBase} data-a-mailto data-mailto-base={mailtoBase}>
                  {copy.assistant.askByEmail}
                </a>
              </li>
            </ul>
          </div>
        </div>

        {/* Server-rendered lookup table: one row per index entry, in the same
            order as the serialized index below. The script never builds HTML
            — it only moves these nodes — so every visible string stays
            localized markup produced by the build. */}
        <ol class="assistant__source" data-a-source hidden>
          {entries.map((entry) => (
            <li class="assistant__row">
              <a class="assistant__row-title" href={entry.hr}>{entry.ti}</a>
              {entry.ba ? (
                <span class={`chip assistant__row-badge chip--${entry.bv}`}>{entry.ba}</span>
              ) : null}
              {entry.yr ? <span class="assistant__row-year">{entry.yr}</span> : null}
              <p class="assistant__row-snippet">{entry.sn}</p>
            </li>
          ))}
        </ol>
      </div>

      <script type="application/json" data-assistant-index set:html={indexJson} />
    </div>
  )
}

<script>
  import type { AssistantEntry } from '../lib/assistant-search';
  import { searchEntries } from '../lib/assistant-search';
  // The ranking layer is imported DYNAMICALLY inside the script (see
  // `loadSemantic` and `run`): the bundler emits it as its own chunk, so a
  // visit that never opens the panel never downloads it — the code-split
  // equivalent of an Astro island for a vanilla-script widget.
  import type { SemanticIndex } from '../lib/semantic-search';

  (() => {
    const root = document.querySelector<HTMLElement>('[data-assistant]');
    const index = document.querySelector<HTMLScriptElement>('[data-assistant-index]');
    if (!root || !index) return;

    let entries: AssistantEntry[];
    try {
      const parsed: unknown = JSON.parse(index.textContent ?? '[]');
      if (!Array.isArray(parsed)) return;
      entries = parsed as AssistantEntry[];
    } catch {
      return;
    }

    const fab = root.querySelector<HTMLButtonElement>('[data-a-fab]');
    const panel = root.querySelector<HTMLElement>('[data-a-panel]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-a-close]');
    const form = root.querySelector<HTMLFormElement>('[data-a-form]');
    const input = root.querySelector<HTMLInputElement>('[data-a-input]');
    const source = root.querySelector<HTMLElement>('[data-a-source]');
    const out = root.querySelector<HTMLElement>('[data-a-out]');
    const error = root.querySelector<HTMLElement>('[data-a-error]');
    const label = root.querySelector<HTMLElement>('[data-a-label]');
    const results = root.querySelector<HTMLElement>('[data-a-results]');
    const fallback = root.querySelector<HTMLElement>('[data-a-fallback]');
    const mailto = root.querySelector<HTMLAnchorElement>('[data-a-mailto]');
    if (
      !fab || !panel || !closeButton || !form || !input || !source ||
      !out || !error || !label || !results || !fallback || !mailto
    ) {
      return;
    }

    // Same order as `entries` — the build renders the rows from that array.
    const rows = Array.from(source.children) as HTMLElement[];
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-a-chip]'));
    let opener: HTMLElement | null = null;

    /**
     * The semantic asset, fetched at most once per page visit. It is a static,
     * same-origin JSON file the build wrote; there is no AI call here. Absent,
     * keyword-only or malformed → `null` → `hybridSearch` behaves exactly like
     * the v1 keyword search. `parseSemanticIndex` enforces the alignment (one
     * vector per entry) so a stale file can never mis-rank a result.
     */
    let semanticIndex: SemanticIndex | null = null;
    let semanticLoaded = false;
    const loadSemantic = async (): Promise<SemanticIndex | null> => {
      if (semanticLoaded) return semanticIndex;
      semanticLoaded = true;
      try {
        // Dynamic import: the ranking code is a separate chunk, fetched only
        // when this visit actually needs it.
        const { SEMANTIC_INDEX_FILE, parseSemanticIndex } = await import(
          '../lib/semantic-search'
        );
        const url = `${import.meta.env.BASE_URL}${SEMANTIC_INDEX_FILE}`;
        const response = await fetch(url, { credentials: 'omit' });
        if (!response.ok) return null;
        semanticIndex = parseSemanticIndex(await response.json(), entries.length);
      } catch {
        semanticIndex = null;
      }
      return semanticIndex;
    };

    const openPanel = () => {
      if (!panel.hidden) return;
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false;
      fab.setAttribute('aria-expanded', 'true');
      input.focus();
      // Warm the semantic asset while the visitor types, so the first search
      // is not delayed by the fetch. Failures are silent by design.
      void loadSemantic();
    };

    const closePanel = () => {
      if (panel.hidden) return;
      panel.hidden = true;
      fab.setAttribute('aria-expanded', 'false');
      (opener ?? fab).focus();
      opener = null;
    };

    fab.addEventListener('click', () => (panel.hidden ? openPanel() : closePanel()));
    closeButton.addEventListener('click', closePanel);

    const visibleFocusables = (): HTMLElement[] =>
      Array.from(panel.querySelectorAll<HTMLElement>('button, input, a[href]')).filter(
        (el) => el.offsetParent !== null,
      );

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        closePanel();
        return;
      }
      if (event.key !== 'Tab') return;
      // Minimal focus containment for the modal: wrap at both ends.
      const items = visibleFocusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || active === panel || !panel.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (panel.hidden) return;
      const target = event.target;
      if (target instanceof Node && !panel.contains(target) && !fab.contains(target)) {
        closePanel();
      }
    });

    // Contain PROGRAMMATIC focus too (the Tab wrap only handles keyboard
    // focus): while the modal panel is open, focus landing outside it —
    // except on the FAB, which toggles the panel closed — is pulled back to
    // the input. That is what `aria-modal` promises assistive tech.
    document.addEventListener('focusin', (event) => {
      if (panel.hidden) return;
      const target = event.target;
      if (target instanceof Node && panel.contains(target)) return;
      if (target instanceof Node && fab.contains(target)) return;
      input.focus();
    });

    const run = async (query: string) => {
      const trimmed = query.trim();
      if (trimmed === '') {
        out.hidden = true;
        error.hidden = true;
        return;
      }
      out.hidden = false;
      error.hidden = true; // Hide any previous error
      // `aria-busy` marks the live region as mid-update while the only real
      // await runs (the at-most-once fetch of the ranking chunk + asset).
      out.setAttribute('aria-busy', 'true');
      // Reset row positions, then append the winners in ranked order; moving
      // a node into `results` empties the previous listing by itself.
      rows.forEach((row) => source.append(row));
      // Semantic when the build shipped vectors and the query clears the
      // threshold; otherwise exactly the v1 keyword ranking (see
      // `lib/semantic-search.ts`). The import is dynamic so the ranking code
      // downloads on first search, not on page load.
      let hits;
      try {
        const { hybridSearch } = await import('../lib/semantic-search');
        hits = hybridSearch(entries, await loadSemantic(), trimmed, 3);
      } catch {
        // The semantic search module failed to load.
        // Fall back to keyword-only search.
        error.hidden = false;
        error.textContent = 'Search module failed to load. Showing keyword results instead.';
        hits = searchEntries(entries, trimmed, 3);
      } finally {
        out.removeAttribute('aria-busy');
      }
      if (hits.length > 0) {
        label.hidden = false;
        fallback.hidden = true;
        results.hidden = false;
        for (const hit of hits) {
          const row = rows[entries.indexOf(hit)];
          if (row) results.append(row);
        }
      } else {
        // The honest path: nothing matched, so say so and offer the doors
        // that actually exist — no invented answer, no guessed intent.
        label.hidden = true;
        results.hidden = true;
        fallback.hidden = false;
        const base = mailto.dataset.mailtoBase ?? `mailto:?body=`;
        mailto.href = `${base}${encodeURIComponent(trimmed)}`;
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void run(input.value);
    });

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const query = chip.dataset.query ?? chip.textContent ?? '';
        // Show the query that actually ran — transparency over theatre.
        input.value = query;
        void run(query);
      });
    }

    /**
     * Deep-link seam: a page-level "Ask about this page" button
     * (`components/AskAboutPage.astro`) dispatches a bubbling `assistant:ask`
     * CustomEvent carrying the seed query. The button only SEEDS — the search
     * below is this widget's own (`run`), over the index this page already
     * embeds, so the seed can never produce an answer the widget could not
     * produce by hand. The input shows the exact words that ran, the same
     * transparency rule the chips follow. Opening through `openPanel` also
     * records the button as the `opener`, so closing returns focus to it; when
     * the panel is already open the event only re-focuses the input. An empty
     * seed is ignored rather than turned into a search.
     */
    document.addEventListener('assistant:ask', (event) => {
      const detail = (event as CustomEvent<{ query?: unknown } | null>).detail;
      const query = typeof detail?.query === 'string' ? detail.query.trim() : '';
      if (query === '') return;
      if (panel.hidden) openPanel();
      else input.focus();
      input.value = query;
      void run(query);
    });

    // Guarded regions: at narrow widths the FAB's corner overlaps the home
    // hero's action row at the top and the footer notes at the bottom, so the
    // CSS hides the FAB (mobile only) while either is in view. Mark the widget
    // when one is visible; the FAB returns in the long middle of the page. No
    // guarded region on the page means no marker and no change, and without
    // IntersectionObserver the fallback is today's always-visible button. The
    // marker is never toggled while the panel is open, so an open dialog is
    // not affected by scrolling.
    const guarded = [document.querySelector('.hero'), document.querySelector('.site-footer')].filter(
      (el): el is HTMLElement => el !== null,
    );
    if (guarded.length > 0 && 'IntersectionObserver' in window) {
      const visible = new Set<Element>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          }
          if (!panel.hidden) return;
          root.toggleAttribute('data-fab-guard', visible.size > 0);
        },
        { threshold: 0 },
      );
      guarded.forEach((region) => observer.observe(region));
    }
  })();
</script>

<style>
  /* No-JS: the assistant needs scripting to open, so the button is hidden
     unless the pre-paint `html.js` gate ran — the same progressive-enhancement
     contract as the mobile nav. Nothing else on the page changes. */
  .assistant__fab {
    display: none;
  }

  html.js .assistant__fab {
    display: inline-flex;
  }

  .assistant__fab {
    position: fixed;
    right: var(--space-6);
    bottom: var(--space-6);
    z-index: 90;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      visibility var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  /* --- Guarded regions (mobile only) --------------------------------------
   * At narrow widths the FAB's bottom-right corner is exactly where two
   * full-width regions put their content: the home hero's action row at the
   * top (it would cover the "Inspect the evidence" CTA) and the footer notes
   * at the bottom (it would cover the last line of the build/theme notes).
   * While either guarded region is in view on a small screen the FAB is
   * therefore hidden; it reappears in the long middle of the page, where
   * search is actually useful. Desktop keeps the button at all times: neither
   * region reaches that corner there. The `data-fab-guard` marker is set by
   * the observer below and stays absent on any page without a guarded region,
   * so those pages are unchanged.
   * ---------------------------------------------------------------------- */
  @media (max-width: 767.98px) {
    .assistant[data-fab-guard] .assistant__fab {
      opacity: 0;
      visibility: hidden;
      transform: translateY(calc(var(--space-3) + 8px)) scale(0.9);
      pointer-events: none;
    }
  }

  /* Show/hide is a state change, not decoration: keep it, but drop the
     transition so nothing moves when the visitor asked for reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .assistant__fab {
      transition: none;
    }

    .assistant[data-fab-guard] .assistant__fab {
      transform: none;
    }
  }

  .assistant__fab:hover {
    background-color: color-mix(in srgb, var(--color-accent) 85%, var(--color-text));
  }

  .assistant__fab svg {
    width: 22px;
    height: 22px;
  }

  .assistant__panel {
    position: fixed;
    right: var(--space-6);
    bottom: calc(var(--space-6) + 68px);
    z-index: 91;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: min(380px, calc(100vw - var(--space-6) * 2));
    max-height: calc(100vh - var(--space-6) * 2 - 68px);
    overflow-y: auto;
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Class `display` rules outrank the UA `[hidden]` rule, so every toggled
     element re-asserts hiding explicitly. The panel is static with no open
     animation: reduced motion cannot be disrespected by motion that does
     not exist. */
  .assistant__panel[hidden],
  .assistant__out[hidden],
  .assistant__error[hidden],
  .assistant__out-label[hidden],
  .assistant__results[hidden],
  .assistant__fallback[hidden],
  .assistant__source[hidden] {
    display: none;
  }

  .assistant__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .assistant__title {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-md);
  }

  .assistant__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .assistant__close:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .assistant__close svg {
    width: 16px;
    height: 16px;
  }

  /* The honesty banner sits at the top of the panel on purpose: it is read
     before the first input, not whispered under the results. */
  .assistant__banner {
    margin: 0;
    padding: var(--space-3);
    background-color: var(--color-surface-raised);
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  /* The live search mode, stated from the generated build metadata — a fact
     about this build, not decoration, so it reads as a plain line. */
  .assistant__mode {
    margin: 0;
    color: var(--color-text-muted);
