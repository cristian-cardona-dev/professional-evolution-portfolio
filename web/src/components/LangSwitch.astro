---
/**
 * Language switch — en/es routes.
 *
 * `en` is the default locale and therefore served from the site root, while
 * `es` lives under `/es/`. `hreflang` + `lang` mark the target language so
 * assistive tech announces the switch correctly, and `aria-current="page"`
 * marks the locale actually being read.
 */
import type { Copy, Locale } from '../i18n/copy';
import { route } from '../lib/urls';

interface Props {
  copy: Copy;
  locale: Locale;
  /** Locale-relative path; when provided, links point at the same page in the other locale. */
  path?: string;
}

const { copy, locale, path } = Astro.props;

const options: { code: Locale; href: string; language: string; label: string }[] = [
  { code: 'en', href: path ? route('en', path) : route('en'), language: 'English', label: copy.lang.switchToEn },
  { code: 'es', href: path ? route('es', path) : route('es'), language: 'Español', label: copy.lang.switchToEs },
];
---

<nav class="lang-switch" aria-label={copy.lang.label}>
  <ul class="lang-switch__list">
    {
      options.map((option) => (
        <li>
          <a
            class="lang-switch__link"
            href={option.href}
            data-locale-switch
            hreflang={option.code}
            lang={option.code}
            title={option.label}
            aria-current={locale === option.code ? 'page' : undefined}
          >
            <span aria-hidden="true">{option.code.toUpperCase()}</span>
            <span class="visually-hidden">
              {option.language} · {option.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('[data-locale-switch]');
    if (!link || !window.location.hash) return;
    const destination = new URL(link.href);
    destination.hash = window.location.hash;
    link.href = destination.toString();
  });
</script>

<style>
  .lang-switch__list {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switch__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .lang-switch__link:hover {
    color: var(--color-accent);
    background-color: var(--color-surface-raised);
  }

  .lang-switch__link[aria-current='page'] {
    color: var(--color-accent);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }
</style>
