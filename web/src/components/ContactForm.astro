---
/**
 * Contact section — "Address in display rows" (redesign Task 7).
 *
 * The contact block is a stack of five full-width display rows, each set at
 * clamp(44px, 6vw, 88px) regular weight, text sitting in the lower third of
 * each ~150px-tall band. Rows alternate between two flat tones of the section
 * colour as full-width bands. A sixth row holds the greeting ("Talk soon")
 * followed by a solid round arrow button that opens the Cal.com booking link
 * (or mailto fallback until the URL is confirmed).
 *
 * The address of this subject is its reach: no street, no city — a timezone,
 * two languages, an inbox, a booking link. No heading, no form.
 *
 * Phone: rows at 9.6vw with 16px insets, ~84px tall; the greeting row becomes
 * a full-width accent band with a 56px round button at its right end.
 */
import type { Copy } from '../i18n/copy';
import { profile } from '../lib/data';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;

/** Cal.com URL pending; the copy deck's fallback is a mailto with a subject. */
const ctaHref = `mailto:${profile.email}?subject=${encodeURIComponent(
  copy.hero.ctaSubject,
)}`;

/** The five display rows: name, location, hours, languages, email. */
const displayRows = [
  { text: profile.name, type: 'name' },
  { text: copy.contact.displayRowLocation, type: 'text' },
  { text: copy.contact.displayRowHours, type: 'text' },
  { text: copy.contact.displayRowLanguages, type: 'text' },
  { text: profile.email, type: 'email', href: `mailto:${profile.email}` },
];
---

<section class="contact" id="contact">
  <div class="contact__rows">
    {
      displayRows.map((row, index) => (
        <div class={`contact__row contact__row--${row.type} contact__row--tone-${index % 2}`}>
          <div class="shell contact__row-inner">
            {row.type === 'email' ? (
              <a class="contact__row-link" href={row.href}>
                {row.text}
              </a>
            ) : (
              <span class="contact__row-text">{row.text}</span>
            )}
          </div>
        </div>
      ))
    }

    <div class="contact__row contact__row--greeting contact__row--accent">
      <div class="shell contact__row-inner contact__greeting">
        <span class="contact__greeting-text">{copy.contact.greeting}</span>
        <a class="contact__greeting-button" href={ctaHref} aria-label={copy.contact.ctaAriaLabel}>
          <svg class="contact__arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The contact section is a stack of full-width bands. Each row is ~150px tall
     with the text sitting in its lower third. Rows alternate between two flat
     tones of the section colour, or use 28px of space alone. */
  .contact {
    padding-block: 0;
  }

  .contact__rows {
    display: flex;
    flex-direction: column;
  }

  /* --- Display rows --------------------------------------------------------
   * Phone size first: 9.6vw per the blueprint (~84px at 390px), with 16px
   * insets. Each row is a full-width band, text in the lower third.
   * --------------------------------------------------------------------- */
  .contact__row {
    display: flex;
    align-items: flex-end;
    min-height: 84px;
    padding-block: 16px;
  }

  .contact__row--tone-0 {
    background-color: var(--color-bg);
  }

  .contact__row--tone-1 {
    background-color: var(--color-surface);
  }

  .contact__row-inner {
    width: 100%;
    padding-inline: 16px;
  }

  .contact__row-text,
  .contact__row-link {
    font-size: 9.6vw;
    line-height: 1.0;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    display: block;
  }

  .contact__row-link {
    /* Email is a link; the underline sits at the accent colour, not the
       text colour, so the row's visual weight is not thrown off by the
       default link style. */
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness var(--duration-fast) var(--ease-standard);
  }

  .contact__row-link:hover {
    text-decoration-thickness: 2px;
  }

  .contact__row--name .contact__row-text {
    font-weight: 500;
  }

  /* --- Greeting row --------------------------------------------------------
   * The sixth row holds the greeting ("Talk soon") and the round arrow
   * button. On phone, it becomes a full-width accent band with a 56px round
   * button at its right end.
   * --------------------------------------------------------------------- */
  .contact__row--greeting {
    background-color: var(--color-accent);
    min-height: 84px;
  }

  .contact__greeting {
    display: flex;
    align-items: baseline;
    gap: 24px;
  }

  .contact__greeting-text {
    font-size: 9.6vw;
    line-height: 1.0;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-accent-ink);
  }

  .contact__greeting-button {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-accent-ink);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-fast) var(--ease-standard),
                background-color var(--duration-fast) var(--ease-standard);
  }

  .contact__greeting-button:hover {
    transform: scale(1.05);
    background-color: color-mix(in srgb, var(--color-accent-ink) 90%, var(--color-accent));
  }

  .contact__arrow {
    width: 24px;
    height: 24px;
  }

  /* --- Desktop: the display rows -------------------------------------------
   * From 900px the rows are clamp(44px, 6vw, 88px) tall, each ~150px with the
   * text in the lower third. Rows alternate between two flat tones.
   * --------------------------------------------------------------------- */
  @media (min-width: 900px) {
    .contact__row {
      min-height: 150px;
      padding-block: 24px;
    }

    .contact__row-inner {
      padding-inline: 0;
    }

    .contact__row-text,
    .contact__row-link {
      font-size: clamp(44px, 6vw, 88px);
    }

    .contact__greeting-text {
      font-size: clamp(44px, 6vw, 88px);
    }

    .contact__row--greeting {
      min-height: 150px;
    }

    .contact__greeting-button {
      /* Button is 0.9em across, centred on the x-height of the greeting text */
      width: 0.9em;
      height: 0.9em;
      font-size: clamp(44px, 6vw, 88px);
    }

    .contact__arrow {
      width: 1em;
      height: 1em;
    }
  }

  /* --- Print --------------------------------------------------------------- */
  @media print {
    .contact__row {
      min-height: auto;
      padding-block: 12px;
    }

    .contact__greeting-button {
      display: none;
    }
  }
</style>
