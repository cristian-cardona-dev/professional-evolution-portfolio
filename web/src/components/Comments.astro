---
/**
 * Comment UI (spec 9) — form, list, translation badge, report link, GDPR note,
 * and one-level threaded replies.
 *
 * Rendered by the content views (`Work`, `Career`, `Evolution`, `BuildNotes`,
 * `CaseStudy`, `MilestonePost`) for the routes `config/comments.json` enables;
 * for every other route the component renders nothing at all, so a page without
 * comments is byte-identical to before this feature.
 *
 * Honest degradation, in this order:
 *   1. `comments.json` does not list the route -> nothing is rendered.
 *   2. Turnstile is not configured (`PUBLIC_TURNSTILE_SITEKEY` unset) -> the
 *      form is rendered DISABLED with an explicit "temporarily unavailable"
 *      note. It is never a form that would silently accept a submission.
 *   3. The API probe fails (e.g. the canonical GitHub Pages host has no
 *      `/api/comments`) -> the form is disabled with the same explicit note.
 *   4. The Turnstile script is blocked -> the form stays disabled and the
 *      message says why.
 * The no-JS path is the same shape as the contact form: a static note plus a
 * mailto link, never a pretend submission.
 *
 * F-B: the realtime presence/WebSocket wiring attaches in the marked place in
 * the inline script below. Presence is rendered best-effort (`~N viendo ahora`)
 * and a dropped socket reconnects with exponential backoff, falling back to a
 * 60s REST poll if it never opens (spec 7). All timers live here, never in the
 * Durable Object.
 */
import type { Copy, Locale } from '../i18n/copy';
import { profile } from '../lib/data';
import { commentsApiBase, commentsEnabled, commentsPageId } from '../lib/comments';

interface Props {
  locale: Locale;
  copy: Copy;
  /** Locale-less route path, e.g. `work/cloud-dashboard/`. */
  path: string;
  /** Optional evidence anchor context (e.g. "evidence-2") for the composer. */
  evidenceAnchor?: string;
  /** On-demand reading translations are restricted to milestone discussion pages. */
  enableReadingTranslation?: boolean;
}

const { locale, copy, path, evidenceAnchor, enableReadingTranslation = false } = Astro.props;
const evidenceContext = evidenceAnchor ? copy.comments.replyingToEvidence.replace('{anchor}', evidenceAnchor) : '';

const enabled = commentsEnabled(path);
const pageId = commentsPageId(locale, path);
const apiBase = commentsApiBase();
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const configured = sitekey.length > 0;
const endpoint = `${apiBase}/api/comments/${encodeURIComponent(pageId)}`;

const mailtoSubject = locale === 'es' ? 'Comentario sobre tu portfolio' : 'Comment on your portfolio';
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(mailtoSubject)}`;

---

{
  enabled && (
    <section
      class="comments"
      id="comments"
      aria-labelledby="comments-heading"
      data-comments
      data-page={pageId}
      data-api-base={apiBase}
      data-locale={locale}
      data-configured={configured ? 'true' : 'false'}
      data-max-length="2000"
      data-anonymous={copy.comments.anonymous}
      data-report={copy.comments.report}
      data-reading-translation={enableReadingTranslation ? 'true' : 'false'}
      data-translate={copy.comments.viewTranslation}
      data-view-original={copy.comments.viewOriginal}
      data-translation-unavailable={copy.comments.translationUnavailable}
      data-machine-translated={copy.comments.machineTranslated}
      data-translation-loading={copy.comments.translationLoading}
      data-translation-error={copy.comments.translationError}
      data-translation-fallback={copy.comments.translationFallback}
      data-translation-ready={copy.comments.translationReady}
      data-original-shown={copy.comments.originalShown}
      data-submit={copy.comments.submit}
      data-submitting={copy.comments.submitting}
      data-turnstile-blocked={copy.comments.turnstileBlocked}
      data-status-posted={copy.comments.statusPosted}
      data-status-queued={copy.comments.statusQueued}
      data-status-rate-limited={copy.comments.statusRateLimited}
      data-status-invalid-body={copy.comments.statusInvalidBody}
      data-status-invalid-token={copy.comments.statusInvalidToken}
      data-status-load-error={copy.comments.statusLoadError}
      data-status-reported={copy.comments.statusReported}
      data-status-report-error={copy.comments.statusReportError}
      data-status-unavailable={copy.comments.statusUnavailable}
      data-presence-template={copy.comments.presenceTemplate}
      data-reconnecting={copy.comments.reconnecting}
      data-new-comment={copy.comments.newComment}
      data-reply={copy.comments.reply}
      data-replying-to={copy.comments.replyingTo}
      data-replying-to-evidence={copy.comments.replyingToEvidence}
      data-cancel-reply={copy.comments.cancelReply}
      data-submit-reply={copy.comments.submitReply}
      data-reply-posted={copy.comments.replyPosted}
      data-reply-queued={copy.comments.replyQueued}
      data-removed-parent={copy.comments.removedParent}
      data-reply-depth-hint={copy.comments.replyDepthHint}
      data-evidence-anchor={evidenceAnchor || ''}
      data-evidence-context={evidenceContext}
    >
      <div class="shell shell--narrow comments__inner">
        <header class="comments__head reveal">
          <p class="eyebrow">{copy.comments.eyebrow}</p>
          <h2 id="comments-heading">{copy.comments.heading}</h2>
          <p class="lead">{copy.comments.summary}</p>
        </header>

        <p class="comments__notice">{copy.comments.notice}</p>

        <div class="comments__list-block">
          <h3 id="comments-list-heading">{copy.comments.listHeading}</h3>
          <p class="comments__status" role="status" aria-live="polite" data-comments-status />
          {/* F-B: arriving comments are announced through this polite live
              region; the realtime client writes the announcement here. */}
          <p class="visually-hidden" role="status" aria-live="polite" data-comments-live />
          {/* Presence is best-effort: "~N viendo ahora", never an exact count. */}
          <p class="comments__presence" data-comments-presence hidden />
          {/* Honest indicator while the socket is dropped (a deploy disconnects
              every socket) and the client is backing off to reconnect. */}
          <p class="comments__reconnect" role="status" data-comments-reconnect hidden />
          <p class="comments__empty" data-comments-empty hidden={!configured}>
            {copy.comments.empty}
          </p>
          <noscript>
            <p class="comments__translation-nojs">{copy.comments.translationNoJs}</p>
          </noscript>
          <ul class="comments__list" data-comments-list aria-labelledby="comments-list-heading" />
        </div>

        <div class="comments__form-block">
          <h3 id="comments-form-heading">{copy.comments.formHeading}</h3>

          <p class="comments__unavailable" data-comments-unavailable hidden={configured}>
            <strong>{copy.comments.unavailableHeading}</strong> {copy.comments.unavailableNote}
          </p>

          <form
            class="comments__form"
            method="POST"
            action={endpoint}
            novalidate
            data-comments-form
            data-endpoint={endpoint}
          >
            <fieldset class="comments__fieldset" data-comments-fieldset disabled>
              {evidenceContext && (
                <p class="comments__evidence-context" data-comments-evidence-context>
                  {evidenceContext}
                </p>
              )}
              {!evidenceContext && (
                <p class="comments__evidence-context" data-comments-evidence-context hidden />
              )}
              {/* Honeypot: hidden from people, tempting to bots. */}
              <div class="comments__honeypot" aria-hidden="true">
                <label for="comments-website">{copy.comments.honeypot}</label>
                <input
                  type="text"
                  id="comments-website"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <div class="comments__field">
                <label class="comments__label" for="comments-name">{copy.comments.nameLabel}</label>
                <input
                  class="comments__input"
                  type="text"
                  id="comments-name"
                  name="name"
                  maxlength="80"
                  autocomplete="off"
                  aria-describedby="comments-name-hint"
                  data-comments-name
                />
                <p class="comments__hint" id="comments-name-hint">{copy.comments.nameHint}</p>
              </div>

              <div class="comments__field">
                <label class="comments__label" for="comments-body">
                  {copy.comments.bodyLabel}
                  <span class="comments__required">({copy.a11y.required})</span>
                </label>
                <textarea
                  class="comments__input comments__input--textarea"
                  id="comments-body"
                  name="body"
                  rows="5"
                  maxlength="2000"
                  required
                  aria-describedby="comments-body-hint"
                  data-comments-body
                />
                <p class="comments__hint" id="comments-body-hint">{copy.comments.bodyHint}</p>
                <p class="comments__counter" aria-hidden="true" data-comments-counter>0/2000</p>
              </div>

              <div class="comments__field">
                <label class="comments__label" for="comments-lang">{copy.comments.langLabel}</label>
                <select
                  class="comments__input"
                  id="comments-lang"
                  name="lang"
                  aria-describedby="comments-lang-hint"
                  data-comments-lang
                >
                  <option value="en" selected={locale === 'en'}>
                    {copy.comments.langEn}
                  </option>
                  <option value="es" selected={locale === 'es'}>
                    {copy.comments.langEs}
                  </option>
                  <option value="other">{copy.comments.langOther}</option>
                </select>
                <p class="comments__hint" id="comments-lang-hint">{copy.comments.langHint}</p>
              </div>

              {configured && (
                <div class="comments__turnstile" data-comments-turnstile data-sitekey={sitekey} />
              )}

              <button class="button button--primary comments__submit" type="submit" data-comments-submit>
                {copy.comments.submit}
              </button>

              <p class="comments__privacy">{copy.comments.privacy}</p>
            </fieldset>
          </form>

          <noscript>
            <div class="comments__nojs">
              <p class="comments__nojs-heading">{copy.comments.noJsHeading}</p>
              <p>{copy.comments.noJsNote}</p>
              <a class="button button--ghost comments__cta" href={mailto}>
                {copy.comments.noJsCta}
              </a>
            </div>
          </noscript>
        </div>
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    const root = document.querySelector('[data-comments]');
    if (!root) return;

    const apiBase = root.dataset.apiBase || '';
    const page = root.dataset.page || '';
    const locale = root.dataset.locale === 'es' ? 'es' : 'en';
    const readingTranslationEnabled = root.dataset.readingTranslation === 'true';
    const maxLength = Number(root.dataset.maxLength || '2000');
    const configured = root.dataset.configured === 'true';
    const presenceTemplate = root.dataset.presenceTemplate || '';
    const reconnectingText = root.dataset.reconnecting || '';
    const newCommentText = root.dataset.newComment || '';
    const replyLabel = root.dataset.reply || 'Reply';
    const replyingToTemplate = root.dataset.replyingTo || 'Replying to {name}';
    const replyingToEvidenceTemplate = root.dataset.replyingToEvidence || 'Discussing {anchor}';
    const cancelReplyLabel = root.dataset.cancelReply || 'Cancel';
    const submitReplyLabel = root.dataset.submitReply || 'Post reply';
    const replyPostedText = root.dataset.replyPosted || 'Reply published.';
    const replyQueuedText = root.dataset.replyQueued || 'Thanks — your reply is waiting for review.';
    const removedParentText = root.dataset.removedParent || 'Comment removed';
    const replyDepthHint = root.dataset.replyDepthHint || 'Replies are limited to one level.';
    let evidenceAnchor = root.dataset.evidenceAnchor || '';

    const form = root.querySelector('[data-comments-form]');
    const fieldset = root.querySelector('[data-comments-fieldset]');
    const list = root.querySelector('[data-comments-list]');
    const empty = root.querySelector('[data-comments-empty]');
    const status = root.querySelector('[data-comments-status]');
    const live = root.querySelector('[data-comments-live]');
    const counter = root.querySelector('[data-comments-counter]');
    const bodyInput = root.querySelector('[data-comments-body]');
    const nameInput = root.querySelector('[data-comments-name]');
    const langSelect = root.querySelector('[data-comments-lang]');
    const submit = root.querySelector('[data-comments-submit]');
    const unavailable = root.querySelector('[data-comments-unavailable]');
    const turnstileSlot = root.querySelector('[data-comments-turnstile]');
    const presenceEl = root.querySelector('[data-comments-presence]');
    const reconnectEl = root.querySelector('[data-comments-reconnect]');

    const endpoint = `${apiBase}/api/comments/${encodeURIComponent(page)}`;
    let turnstileToken = '';

    const setStatus = (message) => {
      if (status) status.textContent = message || '';
    };
    const setLive = (message) => {
      if (live) live.textContent = message || '';
    };
    const disableForm = () => {
      if (fieldset) fieldset.disabled = true;
      if (submit) submit.disabled = true;
      if (unavailable) unavailable.hidden = false;
    };
    const enableForm = () => {
      if (fieldset) fieldset.disabled = false;
      if (submit) submit.disabled = false;
      if (unavailable) unavailable.hidden = true;
    };

    // Presence is best-effort and aggregate only: "~N viendo ahora". It is
    // hidden when the count is unknown or zero.
    const setPresence = (count) => {
      if (!presenceEl) return;
      const n = Number(count);
      if (Number.isFinite(n) && n >= 1 && presenceTemplate) {
        presenceEl.textContent = presenceTemplate.replace('{n}', String(n));
        presenceEl.hidden = false;
      } else {
        presenceEl.textContent = '';
        presenceEl.hidden = true;
      }
    };

    const setReconnecting = (on) => {
      if (!reconnectEl) return;
      reconnectEl.textContent = on ? reconnectingText : '';
      reconnectEl.hidden = !on;
    };

    const formatDate = (timestamp) => {
      const date = new Date(timestamp);
      return date.toLocaleString(locale === 'es' ? 'es-ES' : 'en-GB');
    };

    /**
     * Render source text by default and an explicit on-demand translation
     * control. The same behavior is reused for top-level comments and replies.
     */
    const renderCommentBody = (comment) => {
      const text = document.createElement('p');
      text.className = 'comment__body';
      const original = String(comment.body || '');
      text.textContent = original;

      const meta = document.createElement('p');
      meta.className = 'comment__meta';
      const live = document.createElement('p');
      live.className = 'comment__translation-status';
      live.setAttribute('role', 'status');
      live.setAttribute('aria-live', 'polite');
      live.setAttribute('aria-atomic', 'true');
      live.hidden = true;

      if (
        readingTranslationEnabled &&
        comment.source_lang &&
        comment.source_lang !== locale
      ) {
        if (comment.source_lang === 'en' || comment.source_lang === 'es') {
          const machineLabel = document.createElement('span');
          machineLabel.className = 'chip chip--neutral comment__badge';
          machineLabel.textContent = root.dataset.machineTranslated || '';
          machineLabel.hidden = true;

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'comment__toggle';
          toggle.textContent = root.dataset.translate || 'Translate';
          let translation = '';
          let showingTranslation = false;

          toggle.addEventListener('click', async () => {
            if (translation) {
              showingTranslation = !showingTranslation;
              text.textContent = showingTranslation ? translation : original;
              machineLabel.hidden = !showingTranslation;
              toggle.textContent = showingTranslation
                ? root.dataset.viewOriginal
                : root.dataset.translate;
              live.textContent = showingTranslation
                ? root.dataset.translationReady
                : root.dataset.originalShown;
              live.hidden = false;
              return;
            }

            toggle.disabled = true;
            toggle.textContent = root.dataset.translationLoading || '';
            live.textContent = root.dataset.translationLoading || '';
            live.hidden = false;
            try {
              const response = await fetch(
                `${endpoint}/${encodeURIComponent(comment.id)}/translate`,
                {
                  method: 'POST',
                  headers: { 'content-type': 'application/json', accept: 'application/json' },
                  body: JSON.stringify({ targetLocale: locale }),
                },
              );
              if (!response.ok) throw new Error('translation unavailable');
              const data = await response.json();
              if (typeof data.translation !== 'string' || data.translation.trim().length === 0) {
                throw new Error('empty translation');
              }
              translation = data.translation;
              showingTranslation = true;
              text.textContent = translation;
              machineLabel.hidden = false;
              toggle.textContent = root.dataset.viewOriginal || '';
              live.textContent = root.dataset.translationReady || '';
            } catch {
              text.textContent = original;
              machineLabel.hidden = true;
              toggle.textContent = root.dataset.translate || 'Translate';
              live.textContent = `${root.dataset.translationError || ''} ${root.dataset.translationFallback || ''}`.trim();
            } finally {
              toggle.disabled = false;
            }
          });

          meta.append(toggle, machineLabel);
        } else {
          meta.classList.add('comment__meta--notice');
          meta.textContent = root.dataset.translationUnavailable;
        }
      }

      return { text, meta, live };
    };

    const renderReportButton = (comment) => {
      const report = document.createElement('button');
      report.type = 'button';
      report.className = 'comment__report';
      report.textContent = root.dataset.report;
      report.addEventListener('click', async () => {
        report.disabled = true;
        try {
          const response = await fetch(
            `${endpoint}/${encodeURIComponent(comment.id)}/report`,
            { method: 'POST', headers: { accept: 'application/json' } },
          );
          if (!response.ok) throw new Error('report failed');
          report.textContent = root.dataset.statusReported;
          setStatus(root.dataset.statusReported);
        } catch {
          report.disabled = false;
          setStatus(root.dataset.statusReportError);
        }
      });
      return report;
    };

    /**
     * Render one comment node. `depth` is 0 for roots, 1 for replies. Replies
     * do not get a reply button: the UI enforces one level.
     */
    const renderComment = (comment, depth = 0) => {
      const item = document.createElement('li');
      item.className = `comment ${depth === 1 ? 'comment--reply' : 'comment--root'}`;
      item.dataset.commentId = comment.id;
      if (comment.parent_id) item.dataset.parentId = comment.parent_id;

      const head = document.createElement('div');
      head.className = 'comment__head';

      const who = document.createElement('span');
      who.className = 'comment__name';
      who.textContent = comment.name || root.dataset.anonymous;

      const when = document.createElement('time');
      when.className = 'comment__time';
      when.dateTime = new Date(comment.created_at).toISOString();
      when.textContent = formatDate(comment.created_at);

      head.append(who, when);

      const body = renderCommentBody(comment);

      const actions = document.createElement('p');
      actions.className = 'comment__actions';
      actions.append(renderReportButton(comment));

      item.append(head, body.text);
      if (body.meta.childNodes.length > 0 || body.meta.textContent) item.append(body.meta);
      item.append(body.live);
      item.append(actions);

      if (depth === 0) {
        const replyBlock = document.createElement('div');
        replyBlock.className = 'comment__reply-block';

        const replyBtn = document.createElement('button');
        replyBtn.type = 'button';
        replyBtn.className = 'comment__reply';
        replyBtn.textContent = replyLabel;
        replyBtn.setAttribute('aria-expanded', 'false');
        replyBtn.setAttribute('aria-controls', `reply-composer-${comment.id}`);

        const composer = document.createElement('div');
        composer.className = 'comment__composer';
        composer.id = `reply-composer-${comment.id}`;
        composer.hidden = true;

        const context = document.createElement('p');
        context.className = 'comment__reply-context';
        context.textContent = replyingToTemplate.replace('{name}', comment.name || root.dataset.anonymous);

        const hint = document.createElement('p');
        hint.className = 'comment__reply-hint';
        hint.textContent = replyDepthHint;

        const textarea = document.createElement('textarea');
        textarea.className = 'comments__input comments__input--textarea';
        textarea.rows = 3;
        textarea.maxLength = maxLength;
        textarea.setAttribute('aria-label', replyingToTemplate.replace('{name}', comment.name || root.dataset.anonymous));

        const footer = document.createElement('div');
        footer.className = 'comment__reply-footer';

        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'button button--ghost';
        cancel.textContent = cancelReplyLabel;

        const post = document.createElement('button');
        post.type = 'button';
        post.className = 'button button--primary';
        post.textContent = submitReplyLabel;

        footer.append(cancel, post);
        composer.append(context, hint, textarea, footer);
        replyBlock.append(replyBtn, composer);
        item.append(replyBlock);

        const closeComposer = () => {
          composer.hidden = true;
          replyBtn.setAttribute('aria-expanded', 'false');
          textarea.value = '';
        };
        const openComposer = () => {
          composer.hidden = false;
          replyBtn.setAttribute('aria-expanded', 'true');
          textarea.focus();
        };

        replyBtn.addEventListener('click', openComposer);
        cancel.addEventListener('click', closeComposer);

        const submitReply = async () => {
          const text = textarea.value.trim();
          if (text.length === 0 || text.length > maxLength) {
            setStatus(root.dataset.statusInvalidBody);
            textarea.focus();
            return;
          }
          if (!turnstileToken) {
            setStatus(root.dataset.turnstileBlocked);
            return;
          }
          post.disabled = true;
          post.textContent = root.dataset.submitting;
          setStatus('');
          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({
                body: text,
                name: nameInput ? nameInput.value : '',
                lang: langSelect ? langSelect.value : '',
                website: (root.querySelector('[name="website"]') || {}).value || '',
                turnstileToken,
                parentId: comment.id,
              }),
            });
            if (response.status === 429) {
              setStatus(root.dataset.statusRateLimited);
              return;
            }
            if (response.status === 400) {
              // The client already validated body length; a 400 here is almost
              // always a parent validation error (removed, too deep, etc.).
              setStatus(root.dataset.statusLoadError);
              return;
            }
            if (response.status === 403 || response.status === 503) {
              setStatus(root.dataset.statusInvalidToken);
              return;
            }
            if (!response.ok) throw new Error('post failed');
            const data = await response.json();
            if (data.status === 'published' && data.comment) {
              addComment(data.comment, false);
              setStatus(replyPostedText);
              setLive(replyPostedText);
            } else {
              setStatus(replyQueuedText);
            }
            closeComposer();
            turnstileToken = '';
            if (window.turnstile && turnstileSlot) {
              try {
                window.turnstile.reset(turnstileSlot);
              } catch {
                /* a stale widget must not block the next submission */
              }
            }
          } catch {
            setStatus(root.dataset.statusLoadError);
          } finally {
            post.disabled = false;
            post.textContent = submitReplyLabel;
          }
        };
        post.addEventListener('click', submitReply);
      }

      const repliesList = document.createElement('ul');
      repliesList.className = 'comment__replies';
      repliesList.setAttribute('aria-label', `${replyLabel}: ${comment.name || root.dataset.anonymous}`);
      item.append(repliesList);

      return item;
    };

    const renderTombstone = (replies) => {
      const item = document.createElement('li');
      item.className = 'comment comment--tombstone';

      const notice = document.createElement('p');
      notice.className = 'comment__tombstone';
      notice.textContent = removedParentText;

      const repliesList = document.createElement('ul');
      repliesList.className = 'comment__replies';
      for (const reply of replies) {
        repliesList.append(renderComment(reply, 1));
      }

      item.append(notice, repliesList);
      return item;
    };

    /**
     * Build a threaded view from a flat list. Replies whose parent is missing
     * (removed, pending or flagged) are gathered under an honest tombstone so
     * the conversation does not silently lose context.
     */
    const renderThread = (comments) => {
      if (!list) return;
      const byId = new Map();
      for (const comment of comments) byId.set(comment.id, comment);
      const children = new Map();
      const orphans = [];
      for (const comment of comments) {
        if (comment.parent_id) {
          if (byId.has(comment.parent_id)) {
            if (!children.has(comment.parent_id)) children.set(comment.parent_id, []);
            children.get(comment.parent_id).push(comment);
          } else {
            orphans.push(comment);
          }
        }
      }
      list.replaceChildren();
      for (const comment of comments) {
        if (comment.parent_id) continue;
        const rootItem = renderComment(comment, 0);
        const replies = children.get(comment.id) || [];
        const replyList = rootItem.querySelector('.comment__replies');
        for (const reply of replies) {
          replyList.append(renderComment(reply, 1));
        }
        list.append(rootItem);
      }
      if (orphans.length > 0) {
        list.append(renderTombstone(orphans));
      }
      if (empty) empty.hidden = comments.length > 0;
    };

    /**
     * Add one comment to the live list. Returns false when the comment is
     * already rendered, so a comment that arrives both by REST and by the socket
     * is never shown twice. `announce` writes to the polite live region.
     */
    const addComment = (comment, announce) => {
      if (!list || !comment || typeof comment.id !== 'string') return false;
      if (list.querySelector(`[data-comment-id="${comment.id}"]`)) return false;

      if (!comment.parent_id) {
        list.prepend(renderComment(comment, 0));
        if (empty) empty.hidden = true;
        if (announce && newCommentText) setLive(newCommentText);
        return true;
      }

      const parent = list.querySelector(`[data-comment-id="${comment.parent_id}"]`);
      if (parent) {
        const replyList = parent.querySelector('.comment__replies');
        if (replyList) {
          replyList.prepend(renderComment(comment, 1));
          if (announce && newCommentText) setLive(newCommentText);
          return true;
        }
      }

      // Reply to a parent that is not currently visible: render a tombstone.
      const tombstone = renderTombstone([comment]);
      list.prepend(tombstone);
      if (empty) empty.hidden = true;
      if (announce && newCommentText) setLive(newCommentText);
      return true;
    };

    /**
     * Load the published list. `silent` is the background refresh (polling or
     * post-reconnect resync): it must never disable the form or shout an error
     * over the status line.
     */
    const load = async (options) => {
      const silent = !!(options && options.silent);
      try {
        const response = await fetch(endpoint, { headers: { accept: 'application/json' } });
        if (!response.ok) throw new Error('list failed');
        const data = await response.json();
        if (Array.isArray(data.comments)) {
          renderThread(data.comments);
        }
        if (typeof data.presence === 'number') setPresence(data.presence);
        if (!silent) enableForm();
        return true;
      } catch {
        if (!silent) {
          disableForm();
          setStatus(root.dataset.statusUnavailable);
        }
        return false;
      }
    };

    const renderTurnstile = () => {
      if (!turnstileSlot) return;
      if (!window.turnstile) {
        setStatus(root.dataset.turnstileBlocked);
        disableForm();
        return;
      }
      window.turnstile.render(turnstileSlot, {
        sitekey: turnstileSlot.dataset.sitekey,
        action: 'comment',
        theme: 'auto',
        callback: (token) => {
          turnstileToken = token;
        },
        'error-callback': () => {
          turnstileToken = '';
        },
        'expired-callback': () => {
          turnstileToken = '';
        },
      });
    };

    window.addEventListener('comments-turnstile-ready', renderTurnstile);
    window.addEventListener('comments-turnstile-error', () => {
      setStatus(root.dataset.turnstileBlocked);
      disableForm();
    });

    if (bodyInput && counter) {
      bodyInput.addEventListener('input', () => {
        counter.textContent = `${bodyInput.value.length}/${maxLength}`;
      });
    }

    const submitMainForm = async (event) => {
      event.preventDefault();
      const body = (bodyInput ? bodyInput.value : '').trim();
      if (body.length === 0 || body.length > maxLength) {
        setStatus(root.dataset.statusInvalidBody);
        if (bodyInput) bodyInput.focus();
        return;
      }
      if (!turnstileToken) {
        setStatus(root.dataset.turnstileBlocked);
        return;
      }
      if (submit) {
        submit.disabled = true;
        submit.textContent = root.dataset.submitting;
      }
      setStatus('');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            body,
            name: nameInput ? nameInput.value : '',
            lang: langSelect ? langSelect.value : '',
            website: (root.querySelector('[name="website"]') || {}).value || '',
            turnstileToken,
            evidenceAnchor: evidenceAnchor || undefined,
          }),
        });
        if (response.status === 429) {
          setStatus(root.dataset.statusRateLimited);
          return;
        }
        if (response.status === 400) {
          setStatus(root.dataset.statusInvalidBody);
          return;
        }
        if (response.status === 403 || response.status === 503) {
          setStatus(root.dataset.statusInvalidToken);
          return;
        }
        if (!response.ok) throw new Error('post failed');
        const data = await response.json();
        if (data.status === 'published' && data.comment) {
          addComment(data.comment, false);
          setStatus(root.dataset.statusPosted);
          setLive(root.dataset.statusPosted);
        } else {
          setStatus(root.dataset.statusQueued);
        }
        if (bodyInput) bodyInput.value = '';
        if (counter) counter.textContent = `0/${maxLength}`;
        turnstileToken = '';
        if (window.turnstile && turnstileSlot) {
          try {
            window.turnstile.reset(turnstileSlot);
          } catch {
            /* a stale widget must not block the next submission */
          }
        }
      } catch {
        setStatus(root.dataset.statusLoadError);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = root.dataset.submit;
        }
      }
    };

    const setEvidenceContext = (anchor) => {
      if (!form) return;
      evidenceAnchor = anchor;
      let context = form.querySelector('[data-comments-evidence-context]');
      if (!context) {
        context = document.createElement('p');
        context.className = 'comments__evidence-context';
        context.dataset.commentsEvidenceContext = '';
        form.insertBefore(context, form.firstElementChild);
      }
      context.textContent = replyingToEvidenceTemplate.replace('{anchor}', anchor);
      context.hidden = false;
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-comments-trigger][data-evidence-anchor]');
      if (!trigger) return;
      event.preventDefault();
      const anchor = trigger.dataset.evidenceAnchor;
      if (!anchor) return;
      setEvidenceContext(anchor);
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (bodyInput) bodyInput.focus();
    });

    if (form) {
      form.addEventListener('submit', submitMainForm);
    }

    // --- Realtime (F-B, spec 7) --------------------------------------------
    // The socket is server -> client only. All timers live HERE, never in the
    // Durable Object: a deploy disconnects every socket, so the client backs
    // off exponentially and falls back to a 60s REST poll if it never opens.
    const BACKOFF_BASE_MS = 1000;
    const BACKOFF_CAP_MS = 30000;
    const POLL_INTERVAL_MS = 60000;
    const RECONNECT_INDICATOR_ATTEMPTS = 3;

    let socket = null;
    let reconnectTimer = null;
    let pollTimer = null;
    let reconnectAttempts = 0;
    let everConnected = false;

    const socketUrl = () => {
      const base = apiBase || window.location.origin;
      const url = new URL(
        `${base}/api/comments/${encodeURIComponent(page)}/ws`,
        window.location.href,
      );
      url.protocol = url.protocol === 'https:' ? 'wss:' : 'ws:';
      return url.toString();
    };

    const startPolling = () => {
      if (pollTimer !== null) return;
      pollTimer = window.setInterval(() => {
        if (!socket || socket.readyState !== 1) load({ silent: true });
      }, POLL_INTERVAL_MS);
    };

    const stopPolling = () => {
      if (pollTimer === null) return;
      window.clearInterval(pollTimer);
      pollTimer = null;
    };

    const scheduleReconnect = () => {
      if (reconnectTimer !== null) return;
      // A socket blocked by a proxy never connects: keep the background refresh
      // going, but stop claiming to be "reconnecting" after a few attempts.
      setReconnecting(everConnected || reconnectAttempts < RECONNECT_INDICATOR_ATTEMPTS);
      startPolling();
      const delay = Math.min(BACKOFF_CAP_MS, BACKOFF_BASE_MS * 2 ** reconnectAttempts);
      reconnectAttempts += 1;
      reconnectTimer = window.setTimeout(() => {
        reconnectTimer = null;
        connect();
      }, delay);
    };

    const connect = () => {
      if (typeof window.WebSocket !== 'function') {
        startPolling();
        return;
      }
      let ws;
      try {
        ws = new WebSocket(socketUrl());
      } catch {
        startPolling();
        return;
      }
      socket = ws;
      ws.addEventListener('open', () => {
        everConnected = true;
        reconnectAttempts = 0;
        stopPolling();
        setReconnecting(false);
        // Resync anything published while the socket was down.
        load({ silent: true });
      });
      ws.addEventListener('message', (event) => {
        let frame = null;
        try {
          frame = JSON.parse(event.data);
        } catch {
          return;
        }
        if (!frame || typeof frame !== 'object') return;
        if (frame.type === 'comment' || frame.type === 'reply') {
          if (frame.comment) addComment(frame.comment, true);
          if (typeof frame.presence === 'number') setPresence(frame.presence);
        } else if (frame.type === 'presence' && typeof frame.count === 'number') {
          setPresence(frame.count);
        }
      });
      ws.addEventListener('close', () => {
        if (socket === ws) socket = null;
        scheduleReconnect();
      });
      ws.addEventListener('error', () => {
        // A `close` follows; the reconnect is scheduled there.
      });
    };

    const startRealtime = () => {
      startPolling();
      connect();
    };

    if (configured) {
      load();
      startRealtime();
      const script = document.createElement('script');
      script.src =
        'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.onload = () => window.dispatchEvent(new Event('comments-turnstile-ready'));
      script.onerror = () => window.dispatchEvent(new Event('comments-turnstile-error'));
      document.head.appendChild(script);
    }
  })();
</script>

