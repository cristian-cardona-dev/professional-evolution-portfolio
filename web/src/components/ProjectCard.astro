---
/**
 * Project card — the scannable unit of proof.
 *
 * Every field comes from a `data/projects.json` entry. Nothing is invented:
 * when `screenshots` is empty the card renders a CSS gradient plus the project
 * initials and says so, rather than shipping a placeholder "screenshot".
 *
 * The root element also carries `data-tags` (the project tags, space
 * separated): it is the hook the client-side filter on `/work/` uses to show
 * or hide this card. Without JavaScript the attribute is inert and the card
 * stays visible.
 *
 * Two outbound controls per card: the repository link (external, new tab) and
 * the "Case study" link, which points at this site's own `/work/<slug>/` page
 * in the card's locale — the case study is rendered from the same canonical
 * data the page reads, so there is no reason to send a reader to raw markdown
 * on GitHub.
 *
 * Status colours (tokens doc §2): live -> success, mvp/demo -> accent,
 * prototype -> warn (draft-like), lab/planned -> neutral.
 */
import type { Copy, Locale } from '../i18n/copy';
import type { Project } from '../lib/data';
import { caseStudyFor, relatedProjects } from '../lib/data';
import { route } from '../lib/urls';

interface Props {
  copy: Copy;
  project: Project;
  /** Locale of the page rendering the card; related links target that language's `/work/`. */
  locale?: Locale;
  /** Index used for the reveal stagger on listing grids. */
  revealIndex?: number;
  /**
   * Set on a card that sits in the first viewport: its screenshot then loads
   * eagerly instead of lazily. It defaults to lazy, which is correct for the
   * listing grid on `/work/` where every card is below the fold.
   */
  priority?: boolean;
}

const { copy, project, locale = 'en', revealIndex = 0, priority = false } = Astro.props;

/**
 * The "Case study" control points at this site's own case-study page, in the
 * language of the page rendering the card (`/work/<slug>/`, `/es/work/<slug>/`).
 * The repository link beside it stays on GitHub, so both artifacts remain one
 * click away.
 *
 * The link is shown only when a case study actually documents the project:
 * `caseStudyFor` is the same lookup the detail page uses, so a card can never
 * advertise a write-up that would render as an empty state.
 */
const caseStudyHref = caseStudyFor(project.slug) ? route(locale, `work/${project.slug}/`) : null;

const statusVariant: Record<Project['status'], string> = {
  live: 'chip--success',
  mvp: 'chip--accent',
  demo: 'chip--accent',
  prototype: 'chip--warn',
  lab: 'chip--neutral',
};

const related = relatedProjects(project.slug);

/**
 * Spanish pages read the reviewed `summary_es` when the dataset publishes one;
 * every other locale (and any project without a translation) keeps `summary`.
 */
const summary = locale === 'es' && project.summary_es ? project.summary_es : project.summary;

/** Deterministic hue so a card keeps the same colour across builds. */
const hue = [...project.slug].reduce((total, char) => (total + char.charCodeAt(0)) % 360, 0);

const initials = project.name
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');

/**
 * Screenshot wiring. `data/projects.json` stores paths relative to the site
 * root (`images/site-career.png`), so the deployment base is prepended here:
 * a bare relative path would otherwise resolve against `/work/` on the listing
 * and miss the asset.
 *
 * `width`/`height` are the real intrinsic sizes, read from each PNG's IHDR
 * header. They are keyed by file basename because the card is generic; a
 * screenshot with no recorded size simply omits the attributes (the CSS
 * `aspect-ratio` still reserves the box, so there is no layout shift).
 */
const BASE: string = import.meta.env.BASE_URL;

const SCREENSHOT_SIZES: Record<string, { width: number; height: number }> = {
  'site-career.png': { width: 324, height: 183 },
};

const firstScreenshot = project.screenshots[0];
const screenshotName = firstScreenshot ? (firstScreenshot.split('/').pop() ?? '') : '';
const screenshotSrc = firstScreenshot
  ? `${BASE}${firstScreenshot.replace(/^\/+/, '')}`
  : '';
const screenshotSize = SCREENSHOT_SIZES[screenshotName];
const screenshotAlt = screenshotName
  ? (copy.work.screenshotAlt[screenshotName] ?? copy.work.screenshotAltFallback(project.name))
  : '';
---

<article
  class="project-card reveal"
  id={project.slug}
  data-tags={project.tags.join(' ')}
  style={`--card-hue: ${hue}; --reveal-index: ${revealIndex}`}
  aria-labelledby={`${project.slug}-title`}
>
  <div class="project-card__figure">
    {
      firstScreenshot ? (
        <img
          class="project-card__image"
          src={screenshotSrc}
          alt={screenshotAlt}
          width={screenshotSize?.width}
          height={screenshotSize?.height}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <>
          <span class="project-card__placeholder" aria-hidden="true">
            <span class="project-card__initials">{initials}</span>
          </span>
          <span class="project-card__figure-note">{copy.work.screenshotPlaceholder}</span>
        </>
      )
    }
  </div>

  <div class="project-card__body">
    <div class="project-card__meta">
      <span
        class={`chip ${statusVariant[project.status]}`}
        title={copy.projectStatus.hint[project.status]}
      >
        {copy.projectStatus.label[project.status]}
        <span class="visually-hidden">. {copy.projectStatus.hint[project.status]}</span>
      </span>
    </div>

    <h3 class="project-card__title" id={`${project.slug}-title`}>
      {project.name}
    </h3>

    <p class="project-card__summary">{summary}</p>

    {
      project.tags.length > 0 && (
        <ul class="project-card__tags">
          {project.tags.map((tag) => (
            <li class="project-card__tag">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="project-card__links">
      <a class="project-card__link" href={project.repo} target="_blank" rel="noopener noreferrer">
        {copy.work.repo}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="visually-hidden">({copy.a11y.opensInNewTab})</span>
      </a>
      {
        caseStudyHref && (
          <a class="project-card__link project-card__link--internal" href={caseStudyHref}>
            {copy.work.caseStudy}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }
    </div>

    {
      related.length > 0 && (
        <div class="project-card__related">
          <h4 class="project-card__related-heading">{copy.work.related}</h4>
          <ul class="project-card__related-list">
            {related.map((item) => (
              <li>
                <a href={`${route(locale, 'work/')}#${item.slug}`}>{item.name}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    /* This card carries `.reveal`, so its own transition must also cover the
       reveal properties (the global `html.js .reveal` rule is less specific
       than a scoped class+attribute selector). `translate` is used for the
       hover lift so it composes with the reveal `transform` instead of
       replacing it. */
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      translate var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .project-card:hover {
    translate: 0 -4px;
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .project-card:focus-within {
    border-color: var(--color-accent);
  }

  /* --- Placeholder visual ---------------------------------------------------
   * A gradient derived from the slug hue plus the project initials. Alpha is
   * kept low so the block works in both themes without a contrast cost. */
  .project-card__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0;
  }

  .project-card__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background-image:
      radial-gradient(
        70% 80% at 20% 10%,
        hsl(var(--card-hue) 70% 50% / 0.22) 0%,
        transparent 60%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent) 10%, var(--color-surface-raised)) 0%,
        var(--color-surface) 70%
      );
    border: 1px solid var(--color-border);
  }

  .project-card__initials {
    color: var(--color-accent);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .project-card__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* The capture is already a 16:9 crop of the page top, so `cover` fits it
       exactly; `object-position: top` is kept so a future taller screenshot
       still shows its header instead of an arbitrary middle band. Only cards
       with a screenshot are affected. */
    object-position: top;
    border-radius: var(--radius-md);
  }

  .project-card__figure-note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  /* --- Body ---------------------------------------------------------------- */
  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  /* The status sits in its own row above the title so the chip lands in the
     same place on every card regardless of how long the name is. */
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .project-card__title {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .project-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__tag {
    padding: 2px var(--space-2);
    background-color: var(--color-surface-raised);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .project-card__link svg {
    width: 13px;
    height: 13px;
  }

  /* The case-study link navigates inside the site, so it is styled like the
     site's own navigation rather than like the external repository link. */
  .project-card__link--internal {
    color: var(--color-accent);
  }

  .project-card__related {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .project-card__related-heading {
    margin-bottom: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .project-card__related-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .project-card__related-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>