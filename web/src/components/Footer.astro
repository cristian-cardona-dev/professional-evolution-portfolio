---
/**
 * Footer — "the close" (redesign Task 7).
 *
 * The footer is a designed close, not a sitemap. The name returns at full
 * width, followed by a one-line tagline, a colophon about how the site is
 * built, a credit line for found images (placeholder until Task 5/6 fills
 * it in), and a bilingual notice.
 *
 * The footer renders on every route but receives no `locale` prop, so it
 * reads the locale from the built pathname — the same `<base>es/` signal
 * the URL helpers use.
 */
import type { Copy } from '../i18n/copy';
import { profile } from '../lib/data';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;

const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__name">{profile.name}</p>

    <p class="site-footer__tagline">
      AI engineering on a full-stack and cloud foundation, remote-first.
    </p>

    <p class="site-footer__colophon">
      Built with Astro from a canonical data layer. One GitHub Actions run publishes
      it to two hosts. Every claim on this page points at evidence you can open.
    </p>

    <p class="site-footer__credit">
      Found pictures: title, creator, licence, source — filled in Task 5/6 when
      the open-collection pictures are chosen.
    </p>

    <p class="site-footer__bilingual">
      This site also exists in Español: <a href="/es/">/es</a>.
    </p>

    <p class="site-footer__copyright tabular">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  /* The footer is a designed close. The name returns at full width, followed
     by a one-line tagline, a colophon, a credit line for found images, and a
     bilingual notice. */
  .site-footer {
    margin-block-start: 120px;
    padding-block: 60px 40px;
    background-color: var(--color-surface);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* --- The name returns --------------------------------------------------- */
  .site-footer__name {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.0;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  /* --- The tagline -------------------------------------------------------- */
  .site-footer__tagline {
    font-size: var(--text-md);
    line-height: var(--leading-md);
    color: var(--color-text);
    max-width: 60ch;
  }

  /* --- The colophon ------------------------------------------------------- */
  .site-footer__colophon {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  /* --- The credit line ---------------------------------------------------- */
  .site-footer__credit {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
    font-style: italic;
  }

  /* --- The bilingual notice ----------------------------------------------- */
  .site-footer__bilingual {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
  }

  .site-footer__bilingual a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness var(--duration-fast) var(--ease-standard);
  }

  .site-footer__bilingual a:hover {
    text-decoration-thickness: 2px;
  }

  /* --- The copyright ------------------------------------------------------ */
  .site-footer__copyright {
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    color: var(--color-text-muted);
  }

  /* --- Print -------------------------------------------------------------- */
  @media print {
    .site-footer {
      margin-block-start: 40px;
      padding-block: 20px;
    }

    .site-footer__name {
      font-size: 24px;
    }
  }
</style>
