---
/**
 * Footer — "the close" (redesign Task 7).
 *
 * The footer is a designed close, not a sitemap. The name returns at full
 * width, followed by a one-line tagline, a colophon about how the site is
 * built, a credit line for found images (placeholder until Task 5/6 fills
 * it in), and a bilingual notice.
 *
 * The footer renders on every route but receives no `locale` prop, so it
 * detects the locale from the copy metadata — `copy.meta.languageName` is
 * 'Español' on Spanish pages and 'English' on English pages. This is more
 * reliable than `Astro.url.pathname` during static build, which may not
 * correctly reflect the `/es/` prefix.
 */
import type { Copy } from '../i18n/copy';
import { profile } from '../lib/data';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;

const year = new Date().getUTCFullYear();

// Detect locale from copy metadata: Spanish pages have languageName 'Español',
// English pages have 'English'. This is more reliable than Astro.url.pathname
// during static build, which may not correctly reflect the /es/ prefix.
const isSpanish = copy.meta.languageName === 'Español';
const otherLocaleHref = isSpanish ? '/' : '/es/';
const otherLocaleLabel = isSpanish ? '/en' : '/es';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__name">{profile.name}</p>

    <p class="site-footer__tagline">
      {copy.footer.tagline}
    </p>

    <p class="site-footer__colophon">
      {copy.footer.buildNote}
    </p>

    <p class="site-footer__credit">
      {copy.footer.creditLine}
    </p>

    <p class="site-footer__bilingual">
      {copy.footer.bilingualNotice} <a href={otherLocaleHref}>{otherLocaleLabel}</a>.
    </p>

    <p class="site-footer__copyright tabular">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  /* The footer is a designed close. The name returns at full width, followed
     by a one-line tagline, a colophon, a credit line for found images, and a
     bilingual notice. */
  .site-footer {
    margin-block-start: 120px;
    padding-block: 60px 40px;
    background-color: var(--color-surface);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* --- The name returns --------------------------------------------------- */
  .site-footer__name {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.0;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  /* --- The tagline -------------------------------------------------------- */
  .site-footer__tagline {
    font-size: var(--text-md);
    line-height: var(--leading-md);
    color: var(--color-text);
    max-width: 60ch;
  }

  /* --- The colophon ------------------------------------------------------- */
  .site-footer__colophon {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  /* --- The credit line ---------------------------------------------------- */
  .site-footer__credit {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
    font-style: italic;
  }

  /* --- The bilingual notice ----------------------------------------------- */
  .site-footer__bilingual {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
  }

  .site-footer__bilingual a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness var(--duration-fast) var(--ease-standard);
  }

  .site-footer__bilingual a:hover {
    text-decoration-thickness: 2px;
  }

  /* --- The copyright ------------------------------------------------------ */
  .site-footer__copyright {
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    color: var(--color-text-muted);
  }

  /* --- Print -------------------------------------------------------------- */
  @media print {
    .site-footer {
      margin-block-start: 40px;
      padding-block: 20px;
    }

    .site-footer__name {
      font-size: 24px;
    }
  }
</style>
