---
/**
 * Footer — "the close" (redesign Task 7).
 *
 * The footer is a designed close, not a sitemap. The name returns at full
 * width, followed by a one-line tagline, a colophon about how the site is
 * built, a credit line for found images (placeholder until Task 5/6 fills
 * it in), and a bilingual notice.
 *
 * The bilingual notice links to the SAME PAGE's other locale through
 * `localeRoot` (Task 8): the site deploys under a base path, so a bare
 * `/es/` or `/` href would leave the site and 404 at the domain root. The
 * locale arrives as a prop from `BaseLayout` — the layout already knows it,
 * so no pathname guessing is needed here.
 */
import type { Copy, Locale } from '../i18n/copy';
import { profile } from '../lib/data';
import { localeRoot } from '../lib/urls';
import { formatRelativeTime, freshnessBucket } from '../lib/relative-time';
import snapshot from '../../../github-activity/snapshot.json';

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

const year = new Date().getUTCFullYear();

/* The checked-in activity snapshot's own timestamp — rendered site-wide so the
   data's age is visible outside the activity section (plan phase 9.5). The
   browser never calls GitHub; this is a build-time constant. */
const activityDoc = snapshot as unknown as { captured_at: string };
const activityCapturedAt = activityDoc.captured_at;
const activityFreshness = freshnessBucket(activityCapturedAt);
const activityRelative = formatRelativeTime(activityCapturedAt, locale);

const activityDate = new Date(activityCapturedAt);
const activityAbsolute = Number.isNaN(activityDate.getTime())
  ? activityCapturedAt
  : new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(activityDate);

// The other locale's root, base-aware: `/base/` ↔ `/base/es/`.
const otherLocale = locale === 'es' ? 'en' : 'es';
const otherLocaleHref = localeRoot(otherLocale);
const otherLocaleLabel = `/${otherLocale}`;
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__name">{profile.name}</p>

    <p class="site-footer__tagline">
      {copy.footer.tagline}
    </p>

    <p class="site-footer__colophon">
      {copy.footer.buildNote}
    </p>

    <p class="site-footer__credit">
      {copy.footer.creditLine}
    </p>

    <p class="site-footer__bilingual">
      {copy.footer.bilingualNotice} <a href={otherLocaleHref}>{otherLocaleLabel}</a>.
    </p>

    {/* Snapshot age, stated site-wide. The bucket word carries the meaning and
        the absolute date sits in the title, so colour is never the only signal. */}
    <p
      class={`site-footer__snapshot site-footer__snapshot--${activityFreshness} tabular`}
      title={activityCapturedAt}
    >
      <span class="site-footer__snapshot-mark" aria-hidden="true">
        {activityFreshness === 'fresh' ? '●' : activityFreshness === 'aging' ? '▲' : '■'}
      </span>
      {copy.footer.snapshotLabel}: {activityRelative}
      <span class="visually-hidden">({activityAbsolute})</span>
    </p>

    <p class="site-footer__copyright tabular">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  /* The footer is a designed close. The name returns at full width, followed
     by a one-line tagline, a colophon, a credit line for found images, and a
     bilingual notice. */
  .site-footer {
    margin-block-start: 120px;
    padding-block: 60px 40px;
    background-color: var(--color-surface);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* --- The name returns --------------------------------------------------- */
  .site-footer__name {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.0;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  /* --- The tagline -------------------------------------------------------- */
  .site-footer__tagline {
    font-size: var(--text-md);
    line-height: var(--leading-md);
    color: var(--color-text);
    max-width: 60ch;
  }

  /* --- The colophon ------------------------------------------------------- */
  .site-footer__colophon {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  /* --- The credit line ---------------------------------------------------- */
  .site-footer__credit {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
    font-style: italic;
  }

  /* --- The bilingual notice ----------------------------------------------- */
  .site-footer__bilingual {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-text-muted);
  }

  .site-footer__bilingual a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness var(--duration-fast) var(--ease-standard);
  }

  .site-footer__bilingual a:hover {
    text-decoration-thickness: 2px;
  }

  /* --- The copyright ------------------------------------------------------ */
  .site-footer__copyright {
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    color: var(--color-text-muted);
  }

  /* --- Snapshot age (plan phase 9.5) -------------------------------------- */
  .site-footer__snapshot {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    color: var(--color-text-muted);
  }

  .site-footer__snapshot-mark {
    font-size: 0.7em;
    line-height: 1;
  }

  .site-footer__snapshot--fresh .site-footer__snapshot-mark {
    color: var(--color-success);
  }

  .site-footer__snapshot--aging .site-footer__snapshot-mark {
    color: var(--color-warn);
  }

  .site-footer__snapshot--stale .site-footer__snapshot-mark {
    color: var(--color-danger);
  }

  /* --- Print -------------------------------------------------------------- */
  @media print {
    .site-footer {
      margin-block-start: 40px;
      padding-block: 20px;
    }

    .site-footer__name {
      font-size: 24px;
    }
  }
</style>
