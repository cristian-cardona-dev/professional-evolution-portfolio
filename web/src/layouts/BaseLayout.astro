---
/**
 * Base layout — document shell, SEO metadata, pre-paint theme script,
 * landmarks and styles.
 *
 * Every page passes its locale-relative `path` (e.g. `work/`) so the canonical
 * URL, the Open Graph URL and the hreflang alternates are derived from the
 * same source: `site` + base path + locale + path. That is what keeps the
 * metadata honest on a GitHub Pages project site, where no URL may omit the
 * base path. All values come from `data/profile.json` or the copy catalog —
 * nothing is invented here.
 *
 * FOUC is avoided by resolving the theme in `<head>` before first paint: an
 * explicit choice from localStorage wins, otherwise `prefers-color-scheme`
 * decides. The same script sets `.js`, which gates the hidden initial state of
 * the reveal animation so no-JS visitors always see the content.
 *
 * The reveal observer lives here too — one copy for every route, instead of
 * one per page — and only starts on pages that actually have `.reveal` targets.
 */
import type { Copy, Locale } from '../i18n/copy';
import { getCopy } from '../i18n/copy';
import { profile } from '../lib/data';
import { canonicalUrl } from '../lib/urls';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AssistantWidget from '../components/AssistantWidget.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /**
   * Page part of the `<title>`; the layout appends " — <profile name>".
   * Omitted on home, which uses the full default title from the catalog.
   */
  title?: string;
  description?: string;
  /** Open Graph content type; `article` for case studies, `website` elsewhere. */
  ogType?: 'website' | 'article';
  /** Locale-relative path of this page, e.g. `work/` or `work/<slug>/`. */
  path?: string;
  /**
   * Path of this page's per-route social card inside the deployment base, as
   * returned by `ogCardPath()` in `lib/urls.ts` (e.g. `og/work-en.png`). Omit
   * it on pages that keep the site-wide `og-cover.png`.
   */
  ogImagePath?: string;
  /** Copy locale; also the document language unless `lang` overrides it. */
  locale?: Locale;
  /** `<html lang>`; defaults to the copy locale, i.e. `en` on English pages. */
  lang?: Locale;
  /** Footer slot for the public snapshot identifier. */
  snapshotId?: string;
  /** Marks the currently visible home section for the nav indicator. */
  activeNav?: 'projects' | 'evolution' | 'evidence' | 'contact';
  /** JSON-LD blocks; the home pages pass the Person entity (see lib/seo.ts). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogType = 'website',
  path = '',
  ogImagePath,
  locale = 'en',
  lang,
  snapshotId,
  activeNav,
  jsonLd = [],
} = Astro.props;

const copy: Copy = getCopy(locale);
const documentTitle = title ? `${title} — ${profile.name}` : copy.meta.title;
const metaDescription = description ?? copy.meta.description;

/* Canonical and alternates. The canonical URL is the GitHub Pages project URL
   regardless of the host serving this build. `PUBLIC_CANONICAL_BASE` carries
   that URL (including the Pages base path) and is used verbatim, appending only
   the locale + page path — never the serving base, which would double it. When
   it is absent we fall back to `site` + serving base (a plain Pages build).
   Both locales have every route, so the alternates always resolve; `x-default`
   points at English.
   The computation itself lives in `lib/urls.ts` (`canonicalUrl`) so every
   component that must publish the same URL — the share row's intent anchors —
   provably uses one source and cannot drift to the serving host. */
/* Privacy-first analytics (task E4). The Cloudflare Web Analytics beacon is
   injected ONLY when `PUBLIC_CF_BEACON_TOKEN` is present at build — the same
   env-gated pattern as the Turnstile sitekey in `Comments.astro`. The token is
   public by design (it is the site's own identifier, not a secret), and no
   token means the script is not rendered at all: the shipped HTML is then
   byte-identical to a build without analytics. The token also drives the honest
   disclosure on `/build/` through the generated build metadata, so the page and
   the script can never disagree. */
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const canonicalBase = import.meta.env.PUBLIC_CANONICAL_BASE;
const canonicalUrlFor = (targetLocale: Locale, targetPath: string) =>
  canonicalUrl(targetLocale, targetPath, Astro.site);
const canonical = canonicalUrlFor(locale, path);
const alternateEn = canonicalUrlFor('en', path);
const alternateEs = canonicalUrlFor('es', path);
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const faviconHref = `${import.meta.env.BASE_URL}favicon.svg`;
const faviconIcoHref = `${import.meta.env.BASE_URL}favicon.ico`;
/* Social card. A page that passes `ogImagePath` (the per-route PNG drawn by
   `scripts/generate-og-images.mjs`) advertises that card; every other page keeps
   the site-wide cover from `scripts/brand-assets.mjs`. Either way the URL is
   resolved against the canonical base (not the serving origin) so the mirror
   does not advertise its own URL. Absent when neither source is available (no
   fabricated origin). */
const ogImageFile = ogImagePath ?? 'og-cover.png';
const ogImage = canonicalBase
  ? new URL(ogImageFile, canonicalBase)
  : Astro.site
    ? new URL(`${import.meta.env.BASE_URL}${ogImageFile}`, Astro.site)
    : undefined;
/* The alt text describes the image: the localized page title on pages with
   their own card, the site title on pages that show the generic cover. */
const ogImageAlt = ogImagePath ? (title ?? copy.meta.title) : copy.meta.title;
---

<!doctype html>
<html lang={lang ?? locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="icon" href={faviconIcoHref} sizes="any" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      alternateEn && alternateEs && (
        <>
          <link rel="alternate" hreflang="en" href={alternateEn.href} />
          <link rel="alternate" hreflang="es" href={alternateEs.href} />
          <link rel="alternate" hreflang="x-default" href={alternateEn.href} />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_ES'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {
      /* Google Fonts: Newsreader (display + text) + JetBrains Mono (code).
         `font-display: swap` avoids invisible text while fonts load. Preconnect
         removes the DNS+TLS handshake from the critical path. */
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin
          href="https://fonts.gstatic.com/s/newsreader/v26/cY9VfjOCX1hbuyalUrK49dLac06G1ZGsZBtoBAbDJYQraA.woff2"
        />
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin
          href="https://fonts.gstatic.com/s/jetbrainsmono/v24/tDbv2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKwBNntkaToggR7BYRbKPxDcwg.woff2"
        />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@8..144,300;8..144,400;8..144,600&family=JetBrains+Mono:wght@400;600&display=swap"
        />
      </>
    }
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage.href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogImageAlt} />
          <meta name="twitter:image" content={ogImage.href} />
          <meta name="twitter:image:alt" content={ogImageAlt} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    {
      /* Cloudflare Web Analytics beacon — only with a token at build. `defer`
         keeps it off the critical path; `is:inline` ships it verbatim (it is a
         third-party URL, not a bundle input). No token: nothing is emitted. */
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('pep-theme');
        } catch {
          /* storage unavailable: fall through to the OS preference */
        }
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : preferred;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{copy.a11y.skipToContent}</a>

    <Header copy={copy} locale={locale} active={activeNav} path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer copy={copy} locale={locale} snapshotId={snapshotId} />

    {/* Honest keyword-search assistant (v1). The canonical data is always
        available at build, so the widget renders on every page; it hides
        itself entirely without JavaScript. See docs/assistant.md. */}
    <AssistantWidget copy={copy} locale={locale} />

    <script src="../scripts/motion.js"></script>
  </body>
</html>