---
/**
 * Case-study route (en) — one static page per project in `data/projects.json`,
 * rendering the case study derived from `case-studies/*.md` when one exists
 * and the honest empty state when it does not. The page injects the project's
 * CreativeWork structured data (`lib/seo.ts`) alongside the route metadata.
 */
import type { Locale } from '../../i18n/copy';
import { getCopy } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudy from '../../views/CaseStudy.astro';
import { caseStudyFor, projectRoutes } from '../../lib/data';
import type { Project } from '../../lib/data';
import { projectJsonLd } from '../../lib/seo';
import { ogCardPath } from '../../lib/urls';

interface Props {
  project: Project;
}

export function getStaticPaths() {
  return projectRoutes();
}

const { project } = Astro.props;

const locale: Locale = 'en';
const copy = getCopy(locale);

const title = `${project.name} — ${copy.caseStudy.eyebrow}`;
const description = project.summary;
/* Only a project with a published case study gets its own card; the honest
   empty state keeps the site-wide cover. The generator's two-way check fails
   the build if this ever advertises a card it did not draw. */
const ogImagePath = caseStudyFor(project.slug) ? ogCardPath(locale, `work/${project.slug}/`) : undefined;
/* Structured data for the project this page documents — the same fields the
   page renders, and only a card image the build actually drew. */
const jsonLdBlocks = [projectJsonLd(project, locale, Astro.site, ogImagePath)].filter(
  (block): block is Record<string, unknown> => block !== null,
);
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  ogType="article"
  path={`work/${project.slug}/`}
  ogImagePath={ogImagePath}
  activeNav="projects"
  jsonLd={jsonLdBlocks}
>
  <CaseStudy locale={locale} copy={copy} project={project} />
</BaseLayout>
