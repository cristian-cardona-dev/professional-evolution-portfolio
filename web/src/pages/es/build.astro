---
/**
 * Ruta de notas de construcción (es) — «Cómo está construido este sitio».
 *
 * La composición vive en `src/views/BuildNotes.astro`, compartida con `/build/`,
 * así que ambos locales renderizan la misma estructura desde una sola fuente.
 * Sin `activeNav`: la página no es uno de los cinco destinos de la cabecera, y
 * el pie es desde donde se enlaza.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildNotes from '../../views/BuildNotes.astro';

const { locale, copy } = LOCALE_PAGES.es;

const title = copy.build.title;
const description = copy.build.summary;
---

<BaseLayout locale={locale} title={title} description={description} path="build/">
  <BuildNotes locale={locale} copy={copy} />
</BaseLayout>
