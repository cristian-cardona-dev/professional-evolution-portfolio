---
/**
 * Ruta de trabajo (es) — los cinco proyectos de `data/projects.json`,
 * agrupados por estado, con una tarjeta anclada por `id="<slug>"`.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Work from '../../views/Work.astro';
import { ogCardPath } from '../../lib/urls';

const { locale, copy } = LOCALE_PAGES.es;

const title = copy.nav.work;
const description = copy.work.summary;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path="work/"
  ogImagePath={ogCardPath(locale, 'work/')}
  activeNav="projects"
>
  <Work locale={locale} copy={copy} />
</BaseLayout>
