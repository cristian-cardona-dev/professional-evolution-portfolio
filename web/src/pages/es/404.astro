---
/**
 * Ruta 404 (es) — página de no encontrado con la marca del sitio.
 *
 * Astro la renderiza en `dist/es/404.html`. El texto es deliberadamente
 * honesto: dice que la página no está publicada y enlaza las rutas que sí
 * existen, en lugar de fingir que el contenido se movió o que aparecerá.
 * Usa el layout compartido, así que cabecera, pie, tema y asistente se
 * comportan igual que en cualquier otra página.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { route } from '../../lib/urls';

const { locale, copy } = LOCALE_PAGES.es;
const nf = copy.notFound;
---

<BaseLayout locale={locale} title={nf.heading} description={nf.summary}>
  <section class="section">
    <div class="shell shell--narrow">
      <p class="notfound__code" aria-hidden="true">404</p>
      <header class="notfound__head reveal">
        <p class="eyebrow">{nf.eyebrow}</p>
        <h1>{nf.heading}</h1>
        <p class="lead">{nf.summary}</p>
      </header>
      <div class="notfound__actions">
        <a class="button button--primary" href={route(locale)}>{nf.home}</a>
        <a class="button button--ghost" href={route(locale, 'work/')}>{nf.work}</a>
        <a class="button button--ghost" href={route(locale, 'evidence/')}>{nf.evidence}</a>
      </div>
      <p class="notfound__from" hidden>{nf.returnedFrom}</p>
    </div>
  </section>

  <script is:inline>
    // Mirror guard (es). This page is reached at `<base>es/404/`; if it is ever
    // served for a non-Spanish path (e.g. as a root fallback), send the visitor
    // to the English 404 instead, preserving the requested path. The `/404`
    // guard makes the two 404 pages mutually exclusive, so neither loops.
    (() => {
      const path = location.pathname;
      const base = path.startsWith('/professional-evolution-portfolio/')
        ? '/professional-evolution-portfolio/'
        : '/';
      if (!path.slice(base.length).startsWith('es/') && !path.includes('/404')) {
        location.replace(`${base}404.html?from=${encodeURIComponent(path + location.search)}`);
        return;
      }
      if (new URLSearchParams(location.search).has('from')) {
        document.querySelector('.notfound__from')?.removeAttribute('hidden');
      }
    })();
  </script>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-16) var(--space-24);
    scroll-margin-top: var(--header-height);
  }

  .notfound__code {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .notfound__head {
    margin-block: var(--space-4) var(--space-8);
  }

  .notfound__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .notfound__from {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
