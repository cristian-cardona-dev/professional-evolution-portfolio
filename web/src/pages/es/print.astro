---
/**
 * Perfil imprimible (es) — vista tipo documento de los datos publicados.
 *
 * El contenido sale íntegramente de `data/*.json` a través de `lib/print.ts`:
 * nombre y titular, los cinco proyectos con su estado, resumen y URL del
 * repositorio como texto, los hitos de evolución separados en entregado/en
 * curso y planificado, los enlaces de evidencia y los canales de contacto. No
 * se inventa nada y el texto dice con claridad que es una vista generada, no un
 * documento de CV aprobado. La estructura es idéntica a `/print/`; solo cambian
 * el catálogo y el idioma del documento.
 *
 * El build imprime esta misma ruta en `resume-es.pdf`
 * (`scripts/generate-resume-pdf.mjs`, encadenado al build de `web`), y ese paso
 * falla a partir de dos páginas A4 — por eso `@media print` lleva también la
 * densidad que exige el contrato, sin eliminar ninguna de las afirmaciones que
 * muestra la pantalla.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { printModel } from '../../lib/print';

const { locale, copy } = LOCALE_PAGES.es;
const model = printModel(copy, locale);

const dateFormat = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const formatDate = (iso: string) => dateFormat.format(new Date(`${iso}T00:00:00Z`));
---

<BaseLayout
  locale={locale}
  title={copy.print.title}
  description={copy.print.note}
  path="print/"
>
  <section class="print">
    <div class="shell shell--narrow">
      <header class="print__head">
        <p class="eyebrow">{copy.print.eyebrow}</p>
        <h1>{copy.print.title}</h1>
        <p class="print__note">{copy.print.note}</p>
        <p class="print__generated">{copy.print.generatedNote}</p>
        <button type="button" class="button button--primary print__action" data-print-button>
          {copy.print.printButton}
        </button>
      </header>

      <section class="print__section" aria-labelledby="print-profile-heading">
        <h2 id="print-profile-heading">{copy.print.profileHeading}</h2>
        <p class="print__entry-title">{model.name}</p>
        <p class="print__summary">{model.headline}</p>
      </section>

      <section class="print__section" aria-labelledby="print-projects-heading">
        <h2 id="print-projects-heading">{copy.print.projectsHeading}</h2>
        <ul class="print__list">
          {
            model.projects.map((project) => (
              <li class="print__entry">
                <p class="print__entry-title">
                  {project.name}
                  <span class="print__status">{project.statusLabel}</span>
                </p>
                <p class="print__summary">{project.summary}</p>
                <p class="print__repo">
                  <span class="print__label">{copy.print.repoLabel}</span>{' '}
                  <a class="print__url" href={project.repo}>{project.repo}</a>
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="print__section" aria-labelledby="print-evolution-heading">
        <h2 id="print-evolution-heading">{copy.print.evolutionHeading}</h2>

        <h3 class="print__subheading">{copy.print.shippedHeading}</h3>
        <ul class="print__list">
          {
            model.shipped.map((milestone) => (
              <li class="print__entry print__entry--milestone">
                <time class="print__date" datetime={milestone.date}>
                  {formatDate(milestone.date)}
                </time>
                <span class="print__entry-title">{milestone.title}</span>
                <span class="print__status">{milestone.statusLabel}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="print__subheading">{copy.print.plannedHeading}</h3>
        <ul class="print__list">
          {
            model.planned.map((milestone) => (
              <li class="print__entry print__entry--milestone">
                <time class="print__date" datetime={milestone.date}>
                  {formatDate(milestone.date)}
                </time>
                <span class="print__entry-title">{milestone.title}</span>
                <span class="print__status">{milestone.statusLabel}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="print__section" aria-labelledby="print-evidence-heading">
        <h2 id="print-evidence-heading">{copy.print.evidenceHeading}</h2>
        <ul class="print__list">
          {
            model.evidence.map((item) => (
              <li class="print__entry">
                <p class="print__entry-title">
                  {item.label}
                  {item.statusLabel ? <span class="print__status">{item.statusLabel}</span> : null}
                </p>
                <a class="print__url" href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.url}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="print__section" aria-labelledby="print-contact-heading">
        <h2 id="print-contact-heading">{copy.print.contactHeading}</h2>
        <dl class="print__contact">
          <dt>{copy.print.emailLabel}</dt>
          <dd><a class="print__url" href={`mailto:${model.email}`}>{model.email}</a></dd>
          <dt>{copy.print.githubLabel}</dt>
          <dd><a class="print__url" href={model.github}>{model.github}</a></dd>
          <dt>{copy.print.linkedinLabel}</dt>
          <dd><a class="print__url" href={model.linkedin}>{model.linkedin}</a></dd>
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  // El botón solo imprime; sin JavaScript queda oculto (la puerta `.js`), así
  // que una visita sin scripts no pierde contenido ni ve un control muerto.
  const button = document.querySelector('[data-print-button]');
  if (button instanceof HTMLButtonElement) {
    button.addEventListener('click', () => window.print());
  }
</script>

<style>
  .print {
    padding-block: var(--space-16) var(--space-24);
  }

  .print__head {
    max-width: 68ch;
    margin-bottom: var(--space-12);
  }

  .print__head h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .print__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .print__generated {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  /* Control solo para pantalla: oculto hasta que BaseLayout pone `.js`. */
  .print__action {
    display: none;
    margin-top: var(--space-6);
  }

  html.js .print__action {
    display: inline-flex;
  }

  .print__section {
    margin-top: var(--space-12);
  }

  .print__section > h2 {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .print__subheading {
    margin-top: var(--space-6);
    font-size: var(--text-md);
    line-height: var(--leading-md);
  }

  .print__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Filas, no prosa: el tope global `li { max-width: var(--measure) }`
     truncaría una fila de hito; la prosa interior conserva su propio tope. */
  .print__entry {
    max-width: none;
  }

  .print__entry--milestone {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .print__entry-title {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: var(--leading-md);
  }

  .print__date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .print__status {
    margin-left: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .print__summary {
    max-width: 68ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .print__repo {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
  }

  .print__label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .print__url {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }

  .print__contact {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-4);
  }

  .print__contact dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .print__contact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @page {
    margin: 16mm;
  }

  @media print {
    .print {
      padding: 0;
    }

    .print__action {
      display: none !important;
    }

    /* El papel usa la parte densa de la escala tipográfica.
       `scripts/generate-resume-pdf.mjs` imprime esta ruta en
       `resume-<locale>.pdf` y falla el build si pasa de dos páginas A4, así
       que print declara sus propios tamaños en vez de heredar los de pantalla:
       texto de 12-14 px con interlínea 1.3, espaciados de lista y márgenes de
       sección reducidos a la mitad. No se elimina nada — la hoja lleva
       exactamente las mismas afirmaciones que la pantalla; solo se encoge el
       espacio en blanco. */
    .print__head {
      margin-bottom: var(--space-3);
    }

    .print__head h1 {
      margin-block: var(--space-1) var(--space-2);
      font-size: var(--text-md);
      line-height: 1.3;
    }

    .print__note,
    .print__generated {
      font-size: var(--text-xs);
      line-height: 1.3;
    }

    .print__generated {
      margin-top: 0;
    }

    .print__section {
      margin-top: var(--space-3);
    }

    .print__section > h2 {
      padding-bottom: var(--space-1);
      font-size: var(--text-base);
      line-height: 1.3;
    }

    .print__subheading {
      margin-top: var(--space-2);
      font-size: var(--text-sm);
      line-height: 1.3;
    }

    .print__list {
      gap: var(--space-1);
      margin-top: var(--space-1);
    }

    .print__entry-title {
      font-size: var(--text-sm);
      line-height: 1.3;
    }

    .print__summary {
      margin-top: 0;
      font-size: var(--text-xs);
      line-height: 1.3;
    }

    .print__date,
    .print__status,
    .print__label,
    .print__url,
    .print__repo,
    .print__contact dt,
    .print__contact dd {
      font-size: var(--text-xs);
      line-height: 1.3;
    }

    .print__repo {
      margin-top: 0;
    }

    .print__contact {
      gap: 0 var(--space-3);
      margin-top: var(--space-1);
    }

    /* Evita que una entrada o un bloque de contacto se parta entre hojas. */
    .print__entry,
    .print__contact,
    .print__section > h2 {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .print__url,
    .print__url:visited {
      color: #000;
      text-decoration: none;
    }
  }
</style>
