---
/**
 * Ruta de inicio (es) — comparte la composición con `/` a través de
 * `src/views/Home.astro`; solo cambia el catálogo y el idioma del documento
 * (que `BaseLayout` deriva del locale, así que no se repite aquí).
 *
 * Sin `activeNav`: el inicio no es la página de Trabajo, así que ningún
 * enlace de navegación puede afirmar que está activo.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../views/Home.astro';
import { personJsonLd } from '../../lib/seo';

const { locale, copy } = LOCALE_PAGES.es;

const person = personJsonLd(Astro.site);
---

<BaseLayout locale={locale} path="" jsonLd={person ? [person] : []}>
  <Home locale={locale} copy={copy} />
</BaseLayout>
