---
/**
 * Ruta de evidencia (es) — la lista completa de evidencia de
 * `data/evidence.json`, derivada de la instantánea pública aprobada.
 */
import { LOCALE_PAGES } from '../../i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Evidence from '../../views/Evidence.astro';

const { locale, copy } = LOCALE_PAGES.es;

const title = copy.nav.evidence;
const description = copy.evidence.summary;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path="evidence/"
  activeNav="evidence"
>
  <Evidence locale={locale} copy={copy} />
</BaseLayout>
