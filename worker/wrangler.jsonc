{
  // Chat Worker — free-tier only: the Workers AI binding is the sole provider.
  // No provider API keys or model vars belong here (see worker/src/lib/providers.ts).
  "name": "portfolio-ai-chat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm --prefix worker run build"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_GUARD",
        "class_name": "ChatGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chat-guard",
      "new_sqlite_classes": ["ChatGuard"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-leads",
      "database_id": "38a41618-6b70-4e32-9200-f267be599a96"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "f31d3ce50d6f4e60bf21426fccb56e24"
    }
  ]
}
