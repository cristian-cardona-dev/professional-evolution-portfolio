{
  "name": "professional-evolution-portfolio",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence-backed professional evolution portfolio for Cristian Cardona",
  "scripts": { "assets:generate": "node scripts/brand-assets.mjs", "build": "node site/build.mjs", "build:release": "node site/release-build.mjs", "validate": "node public-snapshot/validate.mjs", "urls:check": "node site/url-registry.mjs", "test": "node --test site/test.mjs scripts/evolution-generate.test.mjs", "doctor": "node site/doctor.mjs", "release:check": "node site/release-check.mjs", "activity:check": "node github-activity/validate.mjs", "check": "npm run build && npm run validate && npm run activity:check && npm run urls:check && npm test && npm run doctor", "web:dev": "npm --prefix web run dev", "web:build": "npm --prefix web run build", "data:validate": "node scripts/data-validate.mjs", "evidence:sync": "node scripts/evidence-sync.mjs", "case-studies:sync": "node scripts/case-studies-sync.mjs", "evolution:generate": "node scripts/evolution-generate.mjs", "resume:generate": "node scripts/generate-resume.mjs", "quality": "npm --prefix web run test:quality", "worker:check": "node web/node_modules/typescript/bin/tsc -p worker/tsconfig.json", "test:comments": "node --test \"worker/tests/**/*.test.mjs\"", "check:all": "npm run check && npm run evidence:sync && npm run case-studies:sync && npm run data:validate && npm run activity:check" },
